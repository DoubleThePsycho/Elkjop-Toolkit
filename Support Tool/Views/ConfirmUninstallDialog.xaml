<Window x:Class="Support_Tool.Views.ConfirmUninstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Uninstall"
        Width="500" SizeToContent="Height"
        MinWidth="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning heading -->
        <TextBlock Grid.Row="0" Text="Confirm permanent removal"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="#FF6B6B" Margin="0,0,0,10"/>

        <!-- Item count label -->
        <TextBlock Grid.Row="1" x:Name="CountLabel"
                   TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource PrimaryTextBrush}"
                   Margin="0,0,0,10"/>

        <!-- Scrollable item list -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12,8" MaxHeight="160" Margin="0,0,0,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="ItemsListText" FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- Instruction -->
        <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8">
            To confirm, type
            <Run FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}">UNINSTALL</Run>
            in the box below:
        </TextBlock>

        <!-- Confirmation text box -->
        <TextBox Grid.Row="4" x:Name="ConfirmTextBox"
                 Background="{StaticResource CardBackgroundBrush}"
                 Foreground="{StaticResource PrimaryTextBrush}"
                 CaretBrush="{StaticResource PrimaryTextBrush}"
                 BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                 Padding="10,8" FontSize="14" FontWeight="SemiBold"
                 Margin="0,0,0,20"
                 TextChanged="ConfirmTextBox_TextChanged"/>

        <!-- Buttons -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cancel"
                    Click="CancelButton_Click"
                    Style="{StaticResource UninstallButtonStyle}"/>

            <Button Grid.Column="2" x:Name="ConfirmButton"
                    Content="Uninstall" IsEnabled="False"
                    Click="ConfirmButton_Click"
                    MinWidth="110">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#8B1A1A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="20,8"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#3A1A1A"/>
                                            <Setter Property="Foreground" Value="#665555"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsEnabled" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#C01A1A"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
