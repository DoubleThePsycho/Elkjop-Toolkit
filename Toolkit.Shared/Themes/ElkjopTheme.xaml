<!-- Shared Elkjøp dark brand theme for the toolkit's WPF apps (Account Setup; Support Tool
     consumes this dictionary's window-shell resources - TitleBarHeight, ChromelessWindowStyle,
     WindowTitleBarBackgroundBrush/WindowBorderBrush/WindowTitleBarSeparatorBrush - while keeping
     its own body/page/card/sidebar brushes local in its own App.xaml, migrated to reference this
     file's semantic names where the visual role matches - see App.xaml's own remarks). This file
     is NOT part of Toolkit.Shared.csproj (that project targets
     plain net10.0 and cannot compile XAML); each WPF app links it as a compiled Page:
         <Page Include="..\Toolkit.Shared\Themes\ElkjopTheme.xaml" Link="Themes\ElkjopTheme.xaml" />
     and merges it in code via pack://application:,,,/Themes/ElkjopTheme.xaml - the BAML compiles
     into each app's own assembly, which is the well-supported case under PublishSingleFile.
     All styles are keyed (no implicit TargetType styles) so nothing restyles by accident.

     SEMANTIC MIGRATION (this revision): this file's own Styles below, and Account Setup's
     SetupWindow.xaml, now consume the Semantic vocabulary block's brushes directly instead of
     the legacy brush names that used to appear further below. This is a rename of which
     resource key each consumer points at, not a value change - the semantic brushes reference
     the exact same raw Colors the legacy ones did, so no rendered color changes as a result of
     this pass. The legacy keys that had zero remaining consumers anywhere in this file or in
     Account Setup were removed outright (Support Tool keeps its own local, independent copies of
     several of the same names in its own App.xaml, entirely unaffected by that removal). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================================
         RAW PALETTE
         ================================================================================
         Every named Color value this staged semantic vocabulary uses, in one place, so a
         semantic brush and a legacy brush can share one source of truth without duplicating a
         hex literal. Values are the existing, already-proven colors already established
         somewhere in this repository (Support Tool/App.xaml's own semantic icon-color pairs,
         MainWindow.xaml's sidebar/nav literals, or this file's own pre-existing brushes just
         below) - nothing here is a newly-invented hue. Where a value's only other home today is
         Support Tool/App.xaml (not this file), that source is named in the value's own comment;
         this pass does not touch Support Tool/App.xaml itself. -->
    <Color x:Key="ColorWindowBackground">#121627</Color>
    <Color x:Key="ColorSurfaceBackground">#181C31</Color>
    <Color x:Key="ColorSurfaceRaised">#1E2340</Color>
    <Color x:Key="ColorSurfaceHover">#272C4A</Color>
    <Color x:Key="ColorDivider">#2A3055</Color>

    <Color x:Key="ColorTextPrimary">#DDE0EE</Color>
    <Color x:Key="ColorTextSecondary">#7A80A0</Color>
    <!-- Support Tool's MainWindow.xaml own sidebar "WORKFLOWS"/"TOOLS" section-label color - more
         muted/desaturated than ColorTextSecondary. Kept as its own distinct value rather than
         merged into ColorTextSecondary since the two are already deliberately different in the
         one place this color is used today. -->
    <Color x:Key="ColorTextMuted">#5560A0</Color>

    <Color x:Key="ColorBrandPrimary">#1E1B58</Color>
    <Color x:Key="ColorBrandPrimaryHover">#2D2A7A</Color>
    <Color x:Key="ColorAccent">#93D500</Color>

    <Color x:Key="ColorError">#C42B1C</Color>
    <!-- Success/Warning-background/Error-background values match Support Tool/App.xaml's own
         existing SuccessIconBrush/SuccessIconBgBrush/WarningIconBgBrush/ErrorIconBgBrush - see
         the Semantic states brush section below for why ColorError reuses this file's existing
         ErrorBrush value rather than a second, differently-named error color, and why Info has no
         distinct value of its own yet. -->
    <Color x:Key="ColorSuccess">#4CAF50</Color>
    <Color x:Key="ColorSuccessBackground">#0E2410</Color>
    <Color x:Key="ColorWarning">#FFB74D</Color>
    <Color x:Key="ColorWarningBackground">#332611</Color>
    <Color x:Key="ColorErrorBackground">#2E0F0F</Color>

    <!-- Support Tool's MainWindow.xaml own sidebar nav-item-hover/separator color - visually
         close to ColorSurfaceHover above (both are "something is hovered" dark-indigo tints) but
         a genuinely different existing value from a different subsystem (sidebar navigation vs.
         content-area cards/controls). Kept as its own raw color rather than forced to match
         ColorSurfaceHover, so neither one's rendered value depends on the other by coincidence. -->
    <Color x:Key="ColorNavigationHover">#2A274A</Color>

    <!-- ================================================================================
         SEMANTIC VOCABULARY (staged - see this file's top-of-file remarks: additive only,
         nothing below is consumed by any existing window/page/control yet)
         ================================================================================ -->

    <!-- Surfaces - the window background and each level of "raised" surface above it. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"  Color="{StaticResource ColorWindowBackground}"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource ColorSurfaceBackground}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush"     Color="{StaticResource ColorSurfaceRaised}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush"      Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="DividerBrush"           Color="{StaticResource ColorDivider}"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush"      Color="{StaticResource ColorTextMuted}"/>
    <!-- No existing distinct disabled-text color anywhere in this repo - disabled treatment
         today is Opacity="0.5"/"0.45" on the enclosing control, not a separate color. Aliased to
         the same raw value as TextSecondaryBrush as a placeholder until a real disabled palette
         exists; revisit once a real consumer needs one. -->
    <SolidColorBrush x:Key="TextDisabledBrush"   Color="{StaticResource ColorTextSecondary}"/>

    <!-- Brand / action -->
    <SolidColorBrush x:Key="BrandPrimaryBrush"      Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource ColorBrandPrimaryHover}"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource ColorAccent}"/>

    <!-- Semantic states - foreground/background pairs. SuccessBrush/SuccessBackgroundBrush and
         WarningBrush/WarningBackgroundBrush are now consumed directly by Support Tool's own
         status-icon contexts (WindowsUpdatePage, InstallPage, MainWindow's footer) - the local
         SuccessIconBrush/SuccessIconBgBrush/WarningIconBgBrush declarations that used to shadow
         these exact values in Support Tool/App.xaml were removed once fully migrated. This file
         already has an existing "ErrorBrush" key below (the legacy WinForms-underline red,
         #C42B1C) - rather than introduce a second, differently-valued key under the same name,
         that existing brush now ALSO serves as this pair's foreground color, paired here with the
         new ErrorBackgroundBrush. Support Tool's separate ErrorIconBrush (#FF6B6B) remains its own
         distinct color for circular icon-glyph contexts specifically - a different existing visual
         role (icon+background pairing vs. a thin accent/hover fill), intentionally not merged with
         this one and kept local in Support Tool/App.xaml. Info has no established color anywhere
         in this codebase yet - aliased to the neutral text/surface colors rather than inventing a
         new hue; revisit once a real consumer needs a distinct one. -->
    <SolidColorBrush x:Key="SuccessBrush"           Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource ColorSuccessBackground}"/>
    <SolidColorBrush x:Key="WarningBrush"           Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource ColorWarningBackground}"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush"   Color="{StaticResource ColorErrorBackground}"/>
    <SolidColorBrush x:Key="InfoBrush"              Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush"    Color="{StaticResource ColorSurfaceRaised}"/>

    <!-- Controls - consumed by DarkTextBoxStyle/DarkPasswordBoxStyle/DarkCheckBoxStyle/
         DarkComboBoxStyle below. -->
    <SolidColorBrush x:Key="ControlBackgroundBrush"    Color="{StaticResource ColorSurfaceRaised}"/>
    <SolidColorBrush x:Key="ControlBorderBrush"        Color="{StaticResource ColorDivider}"/>
    <SolidColorBrush x:Key="ControlHoverBrush"         Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="ControlFocusedBorderBrush" Color="{StaticResource ColorAccent}"/>
    <!-- No distinct existing disabled-control color (same Opacity-based treatment as
         TextDisabledBrush above) - placeholder alias, not yet consumed anywhere. -->
    <SolidColorBrush x:Key="ControlDisabledBrush"      Color="{StaticResource ColorSurfaceRaised}"/>

    <!-- Selection / navigation - consumed by DarkComboBoxItemStyle below
         (SelectionBackgroundBrush) and, where migrated, Support Tool's MainWindow.xaml sidebar
         (NavigationBackgroundBrush/NavigationHoverBrush/NavigationActiveBrush). -->
    <SolidColorBrush x:Key="SelectionBackgroundBrush"  Color="{StaticResource ColorSurfaceHover}"/>
    <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="{StaticResource ColorBrandPrimary}"/>
    <SolidColorBrush x:Key="NavigationHoverBrush"      Color="{StaticResource ColorNavigationHover}"/>
    <SolidColorBrush x:Key="NavigationActiveBrush"     Color="{StaticResource ColorAccent}"/>

    <!-- ================================================================================
         EXISTING BRAND BRUSHES (legacy names still consumed by something)
         ================================================================================ -->
    <SolidColorBrush x:Key="IconPlaceholderBrush"    Color="#FFFFFF15"/>
    <SolidColorBrush x:Key="IconPlaceholderFgBrush"  Color="#4A5590"/>
    <!-- From the WinForms error underline (Color.FromArgb(196, 43, 28)) - also now the Semantic
         states ErrorBrush/ErrorBackgroundBrush pair's foreground color, see that section above. -->
    <SolidColorBrush x:Key="ErrorBrush"              Color="{StaticResource ColorError}"/>

    <!-- Window-shell resources shared by every custom-chrome window's own titlebar strip -
         named for their ROLE (window title bar / window outline / titlebar-to-content
         separator), not for any one specific window, so any window can adopt them regardless of
         its own body palette. WindowTitleBarBackgroundBrush and WindowBorderBrush carry over the
         values Support Tool's RebootCountdownWindow introduced for its own darker, layered
         restart-critical modal; WindowTitleBarSeparatorBrush carries over Account Setup's
         existing titlebar-to-content separator treatment (the same value as SeparatorBrush
         above, under a name that describes this specific role). -->
    <SolidColorBrush x:Key="WindowTitleBarBackgroundBrush" Color="#141833"/>
    <SolidColorBrush x:Key="WindowBorderBrush"             Color="#3A3F5C"/>
    <SolidColorBrush x:Key="WindowTitleBarSeparatorBrush"  Color="#2A3055"/>

    <!-- Icon glyph geometries. Eye glyphs are verbatim the Nucleo-style path data previously
         rasterized by Bypass OOBE's VectorIcon (24x24 viewbox); the rest are Material-style
         24x24 outlines. Use with <Path Data="{StaticResource ...}" Stretch="Uniform"/>. -->
    <Geometry x:Key="EyeHideGlyph">M2.22 2.22a.75.75 0 0 0-.073.976l.073.084 4.034 4.035a9.986 9.986 0 0 0-3.955 5.75.75.75 0 0 0 1.455.364 8.49 8.49 0 0 1 3.58-5.034l1.81 1.81A4 4 0 0 0 14.8 15.86l5.919 5.92a.75.75 0 0 0 1.133-.977l-.073-.084-6.113-6.114.001-.002-6.95-6.946.002-.002-1.133-1.13L3.28 2.22a.75.75 0 0 0-1.06 0ZM12 5.5c-1 0-1.97.148-2.889.425l1.237 1.236a8.503 8.503 0 0 1 9.899 6.272.75.75 0 0 0 1.455-.363A10.003 10.003 0 0 0 12 5.5Zm.195 3.51 3.801 3.8a4.003 4.003 0 0 0-3.801-3.8Z</Geometry>
    <Geometry x:Key="EyeShowGlyph">M12 9.005a4 4 0 1 1 0 8 4 4 0 0 1 0-8ZM12 5.5c4.613 0 8.596 3.15 9.701 7.564a.75.75 0 1 1-1.455.365 8.503 8.503 0 0 0-16.493.004.75.75 0 0 1-1.455-.363A10.003 10.003 0 0 1 12 5.5Z</Geometry>
    <Geometry x:Key="WarningGlyph">M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z</Geometry>
    <Geometry x:Key="InfoGlyph">M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm-1 3h2v2h-2V7Zm0 4h2v6h-2v-6Z</Geometry>
    <Geometry x:Key="CheckCircleGlyph">M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm4.59 3.58L10 14.17l-2.59-2.58L6 13l4 4 8-8-1.41-1.42Z</Geometry>

    <!-- Custom titlebar chrome (System.Windows.Shell.WindowChrome - built into WPF, no NuGet
         package). TitleBarHeight is shared across every WPF window in the toolkit so
         CaptionHeight and each window's own titlebar-strip Height can't drift apart - this value
         alone is meant for every window regardless of resize behavior. A window opts in to THIS
         style with Style="{StaticResource ChromelessWindowStyle}" and then builds its own
         titlebar strip (icon + title + close button) as the first row of its content - see
         Account Setup's Views for the pattern. This particular style is close-only
         (ResizeBorderThickness="0", no minimize/maximize) and is meant for non-resizable windows
         only (Account Setup's SetupWindow, Support Tool's RebootCountdownWindow) - NOT every
         window in the toolkit is ResizeMode="NoResize" (Support Tool's own MainWindow is
         resizable/maximizable and defines its own distinctly-named resizable variant locally,
         reusing this same TitleBarHeight token). -->
    <sys:Double x:Key="TitleBarHeight">36</sys:Double>

    <Style x:Key="ChromelessWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                                     ResizeBorderThickness="0"
                                     GlassFrameThickness="0"
                                     CornerRadius="0"
                                     UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titlebar close button - replaces the default red-hover glyph. IsHitTestVisibleInChrome
         is baked in here rather than repeated on every window, since WindowChrome otherwise
         treats the whole CaptionHeight strip as drag-only and swallows the click. -->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
        <Setter Property="Width"      Value="46"/>
        <Setter Property="Height"     Value="{StaticResource TitleBarHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Cursor"     Value="Arrow"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <Path Data="M8,8 L18,18 M18,8 L8,18" Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ErrorBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reusable titlebar strip content: Image bound to the window's own Icon, TextBlock bound
         to its Title, and the close button above. Kept as a literal ~10-line block copied into
         each window's XAML (not a shared ControlTemplate/UserControl) - the window-level
         Style/Height/close-button-style are what's actually shared and prone to drift; the strip
         itself is small enough that a generic templated abstraction (with the Window-scoped
         CommandBinding routing that would be needed to keep Click wired to each window's own
         Close()/Closing guard) would cost more than it saves for four windows. -->

    <!-- Primary action button - same visuals as Support Tool's UninstallButtonStyle, under a
         purpose-neutral name. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource BrandPrimaryBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="20,8"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrandPrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="20,7"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input - dark card background, separator border that turns green on keyboard focus. -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background"      Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ControlFocusedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background"      Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ControlFocusedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox - 16px retemplated box with a green check mark. -->
    <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                Background="{StaticResource ControlBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M3.5 8.5 6.5 11.5 12.5 4.5" Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ControlFocusedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox - full minimal retemplate (property-only styling leaves a white dropdown and
         light toggle chrome). Non-editable use only (IsEditable stays default false). -->
    <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding"    Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground"         Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background"         Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush"        Value="{StaticResource ControlBorderBrush}"/>
        <Setter Property="FontSize"           Value="13"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="{StaticResource ControlBackgroundBrush}"
                                            BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                            CornerRadius="4">
                                        <Path Data="M7 10 12 15 17 10" Stroke="{StaticResource TextSecondaryBrush}"
                                              StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Stretch="None"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource ControlBackgroundBrush}"
                                    BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indeterminate/marquee progress bar - hand-rolled because the stock indeterminate visual
         ignores Foreground recoloring. A ~30%-width green bar slides across a clipped track. -->
    <Style x:Key="MarqueeProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height"     Value="6"/>
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- Fixed-pixel sweep (TranslateTransform.X animates in pixels, and this
                         dictionary must stay code-free, so no width-fraction converter). All
                         consuming windows are fixed-size/NoResize, so a generous sweep range
                         covers every real track width; the clip hides any overshoot. -->
                    <Border x:Name="Track" Background="{TemplateBinding Background}"
                            CornerRadius="3" ClipToBounds="True">
                        <Border x:Name="Mover" Background="{TemplateBinding Foreground}"
                                CornerRadius="3" HorizontalAlignment="Left" Width="140">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MoverTransform" X="-140"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MoverTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-140" To="700" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only list (ListView + GridView) - flat dark header, no selection chrome. -->
    <Style x:Key="DarkGridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Background"          Value="{StaticResource SurfaceBackgroundBrush}"/>
        <Setter Property="Foreground"          Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"            Value="11"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="Padding"             Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Padding"    Value="10,5"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Background="Transparent"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkListViewStyle" TargetType="ListView">
        <Setter Property="Background"           Value="Transparent"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="Foreground"           Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="ItemContainerStyle"   Value="{StaticResource DarkListViewItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

</ResourceDictionary>
