<UserControl x:Class="Support_Tool.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupPageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource PageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header - identifies this as the Setup workflow; WindowsUpdatePage below carries its
             own detailed status header ("Windows Update" + live status text). -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                Padding="24,14,20,14"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Setup" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Windows Update is required before setup can continue"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Embedded directly (mandatory gate) rather than navigated to and away from - see
             SetupPageViewModel's remarks. Later Setup stages are not yet implemented. -->
        <ContentControl Grid.Row="1" Content="{Binding WindowsUpdate}"/>
    </Grid>

</UserControl>
