<UserControl x:Class="Support_Tool.Views.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             xmlns:views="clr-namespace:Support_Tool.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProgramsPageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource PageBackgroundBrush}">

    <!-- InstalledItemRowTemplate (grid/list card) now lives once, shared with DebloaterPage.xaml,
         in App.xaml's Application.Resources - see its own remarks for why. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                Padding="24,14,20,14"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Programs" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="Remove installed desktop programs"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding SetGridViewCommand}" ToolTip="Grid view" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#18FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding ViewState.IsGridView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"
                              Stretch="Uniform" Width="14" Height="14">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewState.IsGridView}" Value="True">
                                            <Setter Property="Fill" Value="#1A1B28"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Command="{Binding SetListViewCommand}" ToolTip="List view">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#18FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding ViewState.IsListView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"
                              Stretch="Uniform" Width="14" Height="14">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewState.IsListView}" Value="True">
                                            <Setter Property="Fill" Value="#1A1B28"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:DryRunIndicator Grid.Row="1"/>

        <!-- TOOLBAR - search box always available (works against everything discovered so far,
             even mid-scan) and a small non-blocking discovery indicator. Deliberately never a
             full-page overlay - rows discovered so far stay visible and interactive the whole
             time a scan is still running. -->
        <Grid Grid.Row="2" Margin="24,10,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource CardBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         CaretBrush="{StaticResource PrimaryTextBrush}"
                         BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                         Padding="10,6" FontSize="13"/>
                <TextBlock Text="Search programs…" FontSize="13" Margin="12,0,0,0"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding DiscoveryStatusText}" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- CONTENT - shown as soon as discovery starts, not gated behind IsLoading, so rows
             appear incrementally as they're found instead of behind a blocking full-page wait. -->
        <Grid Grid.Row="3" x:Name="ContentArea"
              SizeChanged="ContentArea_SizeChanged">

            <!-- GRID VIEW -->
            <ScrollViewer x:Name="GridScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="GridScrollViewer_Loaded"
                          PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                          Visibility="{Binding ViewState.IsGridView, Converter={StaticResource BoolToVisibility}}"
                          Padding="12,8">
                <!-- WrapPanel, not UniformGrid (external review): UniformGrid was reserving cell
                     height based on the full available viewport instead of packing rows from the
                     top when there are only a few items, so a sparse Programs list rendered a
                     couple of oversized rows filling most of the page. WrapPanel's own ItemWidth
                     (set from GridColumnHelper in code-behind, applies uniformly to every child
                     including ones added later as discovery streams in) keeps the same
                     grid-like, responsive-column look, but a WrapPanel by construction never
                     stretches vertically to fill leftover space - it is always exactly as tall as
                     the rows it actually needs. -->
                <ItemsControl x:Name="GridItemsControl"
                              VerticalAlignment="Top"
                              ItemsSource="{Binding ItemsView}"
                              ItemTemplate="{StaticResource InstalledItemRowTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="3,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- LIST VIEW -->
            <ListBox ItemsSource="{Binding ItemsView}"
                     ItemTemplate="{StaticResource InstalledItemRowTemplate}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                     Visibility="{Binding ViewState.IsListView, Converter={StaticResource BoolToVisibility}}"
                     Padding="12,8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBackgroundBrush}" Padding="20,12"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <!-- Real determinate progress - CompletedItems/TotalItems is an honest known
                     numerator/denominator (the selected count never changes mid-batch), not an
                     animated placeholder. -->
                <StackPanel Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVisibility}}"
                            VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UninstallProgressPercent, Mode=OneWay}"
                                 Height="4" Margin="0,0,0,6"
                                 Foreground="{StaticResource AccentGreenBrush}"
                                 Background="{StaticResource SeparatorBrush}"/>
                    <TextBlock Text="{Binding UninstallProgressText}"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                </StackPanel>
                <Grid Visibility="{Binding IsUninstalling, Converter={StaticResource InvertedBoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text="selected"/>
                        </TextBlock>
                        <Button Content="Uninstall Selected"
                                Command="{Binding UninstallCommand}"
                                Style="{StaticResource UninstallButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
