<UserControl x:Class="Support_Tool.Views.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstallPageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource PageBackgroundBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="InstallableAppCardTemplate" DataType="{x:Type vm:InstallableAppViewModel}">
            <Border Padding="12,8" CornerRadius="6" Margin="0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                        <Border Background="{StaticResource IconPlaceholderBrush}" CornerRadius="8"
                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <Path Fill="{StaticResource IconPlaceholderFgBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-16v4h4V2h-4zm-6 4h4V2h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                        </Border>
                        <Image Source="{Binding Icon}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Installed">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsHitTestVisible="False"/>
                </Grid>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InstallCategoryTemplate" DataType="{x:Type vm:InstallCategoryViewModel}">
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="9,4,0,8">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Cursor="Hand"
                                Visibility="{Binding ShowSelectAll, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox IsThreeState="True"
                                  IsChecked="{Binding SelectAllState, Mode=OneWay}"
                                  Command="{Binding SelectAllCommand}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Select all" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ItemsControl x:Name="CategoryGrid"
                              ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource InstallableAppCardTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="3,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                Padding="24,14,20,14"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Install" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="Install common applications via winget"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- MODE BANNER -->
        <Border Grid.Row="1" Padding="24,7,24,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"      Value="#091508"/>
                    <Setter Property="BorderBrush"     Value="#1C4228"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewState.IsLiveMode}" Value="True">
                            <Setter Property="Background"  Value="#1A0808"/>
                            <Setter Property="BorderBrush" Value="#5A1A1A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ViewState.IsDryRun, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="DRY RUN MODE" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource AccentGreenBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="— No software will be installed" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ViewState.IsLiveMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="LIVE MODE" FontWeight="Bold" FontSize="11"
                               Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="— Selected software will be installed" FontSize="11"
                               Foreground="#C07070" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PREPARING WINGET - a distinct full-page state, never the small footer. WinGet
             preparation (check/repair/verify) can take real time and genuinely mutate the
             machine, so it gets the same prominence a real loading state deserves rather than
             being squeezed into a status line under the generic "Checking available
             applications..." spinner. -->
        <Border Grid.Row="2"
                Visibility="{Binding IsPreparingPrerequisite, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <TextBlock Text="Preparing WinGet" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,14"/>
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" HorizontalAlignment="Center"
                             Foreground="{StaticResource AccentGreenBrush}"
                             Background="{StaticResource SeparatorBrush}" Margin="0,0,0,16"/>

                <!-- Live scrolling detail - real streamed WinGet repair output (our own stage
                     markers plus Repair-WinGetPackageManager's own cleaned verbose lines), so the
                     technician sees actual evidence of activity during a repair that can genuinely
                     take real minutes, not just an indeterminate bar that could mean anything. -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="6"
                        BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                        Visibility="{Binding PrerequisiteDetailText, Converter={StaticResource NullToVisibility}}">
                    <ScrollViewer x:Name="PrerequisiteDetailScrollViewer" Height="180"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                        <TextBlock Text="{Binding PrerequisiteDetailText}" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- LOADING CATALOG - only reached once WinGet is positively confirmed ready. -->
        <Border Grid.Row="2"
                Visibility="{Binding IsLoadingCatalog, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                             Foreground="{StaticResource AccentGreenBrush}"
                             Background="{StaticResource SeparatorBrush}"/>
                <TextBlock Text="Checking available applications…" FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- LOAD FAILED - either WinGet couldn't be prepared, or the catalog itself failed to
             load after WinGet was confirmed ready. No app cards, no install footer, no raw
             PowerShell/CLIXML output - just a clean human-readable reason and a way to retry. -->
        <Border Grid.Row="2"
                Visibility="{Binding IsLoadFailed, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource IconPlaceholderBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Fill="#FF6B6B" Stretch="Uniform" Width="22" Height="22"
                          Data="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                </Border>
                <TextBlock Text="{Binding LoadErrorHeading}" FontSize="16" FontWeight="SemiBold"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding LoadErrorMessage}" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,20"/>
                <Button Content="Retry" Command="{Binding RetryCommand}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- CATALOG READY (grid-only). Visible - and usable - the moment WinGet is ready, not once
             every app's status is known: categories/cards stream in incrementally while this is
             shown (see InstallPageViewModel.LoadCoreAsync), so an already-added card stays fully
             selectable while others are still loading. -->
        <Grid Grid.Row="2" x:Name="ContentArea"
              SizeChanged="ContentArea_SizeChanged"
              Visibility="{Binding IsCatalogReady, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="GridScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="GridScrollViewer_Loaded"
                          PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                          Padding="12,8">
                <ItemsControl x:Name="CategoriesControl"
                              ItemsSource="{Binding Categories}"
                              ItemTemplate="{StaticResource InstallCategoryTemplate}"/>
            </ScrollViewer>

            <!-- Small non-blocking indicator - never a full-page overlay - while apps are still
                 being discovered incrementally. -->
            <Border Background="{StaticResource HeaderBackgroundBrush}" CornerRadius="4"
                    Padding="10,5" Margin="0,10,16,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Visibility="{Binding IsPopulatingCatalog, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CatalogPopulationStatusText}" FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </Border>
        </Grid>

        <!-- FOOTER - install controls only ever appear once the catalog is genuinely ready; no
             footer at all during WinGet preparation, catalog loading, or a load failure. -->
        <Border Grid.Row="3" Background="{StaticResource HeaderBackgroundBrush}" Padding="20,12"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsCatalogReady, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>

                <!-- Inline, non-modal completion state for the last finished batch (replaces the
                     old "Install Complete" popup) - never shown while a new batch is running, and
                     always cleared/replaced the moment the next one starts
                     (InstallPageViewModel.ClearCompletionSummary). No raw WinGet output here -
                     Verbose.log remains authoritative for that. -->
                <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding IsInstalling, Converter={StaticResource InvertedBoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessIconBgBrush}"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompletionSummaryText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CompletionHasIssues}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningIconBgBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompletionHasIssues}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBorderBrush}"/>
                                                <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding CompletionSummaryText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Expander Header="Show details" Margin="24,6,0,0"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding CompletionFailureDetails}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>

                <Grid>
                    <!-- Real determinate progress - CompletedItems/TotalItems is an honest known
                         numerator/denominator (the selected count never changes mid-batch), not an
                         animated placeholder. -->
                    <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}"
                                VerticalAlignment="Center">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallProgressPercent, Mode=OneWay}"
                                     Height="4" Margin="0,0,0,6"
                                     Foreground="{StaticResource AccentGreenBrush}"
                                     Background="{StaticResource SeparatorBrush}"/>
                        <TextBlock Text="{Binding InstallProgressText}"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                    </StackPanel>
                    <Grid Visibility="{Binding IsInstalling, Converter={StaticResource InvertedBoolToVisibility}}">
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text="selected"/>
                            </TextBlock>
                            <Button Content="Install Selected"
                                    Command="{Binding InstallCommand}"
                                    Style="{StaticResource UninstallButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
