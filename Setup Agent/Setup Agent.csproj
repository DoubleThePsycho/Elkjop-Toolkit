<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Setup_Agent</RootNamespace>
    <AssemblyName>SetupAgent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF for all windows; WinForms is kept ONLY for TrayStatusService's NotifyIcon (WPF has
         no tray-icon API and this project takes no NuGet packages) and AppInfo's
         Icon.ExtractAssociatedIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Toolkit.Shared\Images\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stop the WinForms global usings from leaking into WPF code-behind (Application,
         MessageBox, Timer would all be ambiguous) - the two legitimate WinForms/Drawing
         consumers (TrayStatusService, AppInfo) import explicitly instead. System.IO is
         re-added because UseWPF removes it from the implicit set (documented SDK behavior). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toolkit.Shared\Toolkit.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared brand theme, compiled into this assembly (see Toolkit.Shared\Themes) - merged in
         Program.cs via pack://application:,,,/Themes/ElkjopTheme.xaml -->
    <Page Include="..\Toolkit.Shared\Themes\ElkjopTheme.xaml" Link="Themes\ElkjopTheme.xaml" />
    <!-- Window icon (Window.Icon attribute) - same linked-resource shape as Support Tool -->
    <Resource Include="..\Toolkit.Shared\Images\favicon.ico" Link="Resources\favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="WUApiLib">
      <VersionMajor>2</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Guid>b596cc9f-56e5-419e-a622-e01bb457431e</Guid>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

</Project>
