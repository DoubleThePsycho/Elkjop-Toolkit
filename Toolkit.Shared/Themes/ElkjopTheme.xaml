<!-- Shared Elkjøp dark brand theme for the toolkit's WPF apps (Account Setup, Setup Agent; Support
     Tool defines the same brush keys locally in its App.xaml and can migrate here later - keep
     the keys identical). This file is NOT part of Toolkit.Shared.csproj (that project targets
     plain net10.0 and cannot compile XAML); each WPF app links it as a compiled Page:
         <Page Include="..\Toolkit.Shared\Themes\ElkjopTheme.xaml" Link="Themes\ElkjopTheme.xaml" />
     and merges it in code via pack://application:,,,/Themes/ElkjopTheme.xaml - the BAML compiles
     into each app's own assembly, which is the well-supported case under PublishSingleFile.
     All styles are keyed (no implicit TargetType styles) so nothing restyles by accident. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Brand brushes - keys and values identical to Support Tool/App.xaml -->
    <SolidColorBrush x:Key="PageBackgroundBrush"     Color="#121627"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="#181C31"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"     Color="#1E2340"/>
    <SolidColorBrush x:Key="CardHoverBrush"          Color="#272C4A"/>
    <SolidColorBrush x:Key="SeparatorBrush"          Color="#2A3055"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"        Color="#DDE0EE"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"      Color="#7A80A0"/>
    <SolidColorBrush x:Key="AccentGreenBrush"        Color="#93D500"/>
    <SolidColorBrush x:Key="WarningBorderBrush"      Color="#FFB74D"/>
    <SolidColorBrush x:Key="IconPlaceholderBrush"    Color="#FFFFFF15"/>
    <SolidColorBrush x:Key="IconPlaceholderFgBrush"  Color="#4A5590"/>
    <!-- Brand indigo (Support Tool uses these as literals in UninstallButtonStyle/sidebar) -->
    <SolidColorBrush x:Key="BrandIndigoBrush"        Color="#1E1B58"/>
    <SolidColorBrush x:Key="BrandIndigoHoverBrush"   Color="#2D2A7A"/>
    <!-- From the WinForms error underline (Color.FromArgb(196, 43, 28)) -->
    <SolidColorBrush x:Key="ErrorBrush"              Color="#C42B1C"/>

    <!-- Icon glyph geometries. Eye glyphs are verbatim the Nucleo-style path data previously
         rasterized by Bypass OOBE's VectorIcon (24x24 viewbox); the rest are Material-style
         24x24 outlines. Use with <Path Data="{StaticResource ...}" Stretch="Uniform"/>. -->
    <Geometry x:Key="EyeHideGlyph">M2.22 2.22a.75.75 0 0 0-.073.976l.073.084 4.034 4.035a9.986 9.986 0 0 0-3.955 5.75.75.75 0 0 0 1.455.364 8.49 8.49 0 0 1 3.58-5.034l1.81 1.81A4 4 0 0 0 14.8 15.86l5.919 5.92a.75.75 0 0 0 1.133-.977l-.073-.084-6.113-6.114.001-.002-6.95-6.946.002-.002-1.133-1.13L3.28 2.22a.75.75 0 0 0-1.06 0ZM12 5.5c-1 0-1.97.148-2.889.425l1.237 1.236a8.503 8.503 0 0 1 9.899 6.272.75.75 0 0 0 1.455-.363A10.003 10.003 0 0 0 12 5.5Zm.195 3.51 3.801 3.8a4.003 4.003 0 0 0-3.801-3.8Z</Geometry>
    <Geometry x:Key="EyeShowGlyph">M12 9.005a4 4 0 1 1 0 8 4 4 0 0 1 0-8ZM12 5.5c4.613 0 8.596 3.15 9.701 7.564a.75.75 0 1 1-1.455.365 8.503 8.503 0 0 0-16.493.004.75.75 0 0 1-1.455-.363A10.003 10.003 0 0 1 12 5.5Z</Geometry>
    <Geometry x:Key="WarningGlyph">M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z</Geometry>
    <Geometry x:Key="InfoGlyph">M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm-1 3h2v2h-2V7Zm0 4h2v6h-2v-6Z</Geometry>
    <Geometry x:Key="CheckCircleGlyph">M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm4.59 3.58L10 14.17l-2.59-2.58L6 13l4 4 8-8-1.41-1.42Z</Geometry>

    <!-- Custom titlebar chrome (System.Windows.Shell.WindowChrome - built into WPF, no NuGet
         package). Shared across every WPF window in the toolkit so CaptionHeight and each
         window's own titlebar-strip Height can't drift apart. A window opts in with
         Style="{StaticResource ChromelessWindowStyle}" and then builds its own titlebar strip
         (icon + title + close button) as the first row of its content - see Account
         Setup/Setup Agent Views for the pattern. All four current windows are ResizeMode="NoResize"
         already, so ResizeBorderThickness is zeroed with nothing lost. -->
    <sys:Double x:Key="TitleBarHeight">36</sys:Double>

    <Style x:Key="ChromelessWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                                     ResizeBorderThickness="0"
                                     GlassFrameThickness="0"
                                     CornerRadius="0"
                                     UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titlebar close button - replaces the default red-hover glyph. IsHitTestVisibleInChrome
         is baked in here rather than repeated on every window, since WindowChrome otherwise
         treats the whole CaptionHeight strip as drag-only and swallows the click. -->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
        <Setter Property="Width"      Value="46"/>
        <Setter Property="Height"     Value="{StaticResource TitleBarHeight}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="Cursor"     Value="Arrow"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <Path Data="M8,8 L18,18 M18,8 L8,18" Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ErrorBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reusable titlebar strip content: Image bound to the window's own Icon, TextBlock bound
         to its Title, and the close button above. Kept as a literal ~10-line block copied into
         each window's XAML (not a shared ControlTemplate/UserControl) - the window-level
         Style/Height/close-button-style are what's actually shared and prone to drift; the strip
         itself is small enough that a generic templated abstraction (with the Window-scoped
         CommandBinding routing that would be needed to keep Click wired to each window's own
         Close()/Closing guard) would cost more than it saves for four windows. -->

    <!-- Primary action button - same visuals as Support Tool's UninstallButtonStyle, under a
         purpose-neutral name. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource BrandIndigoBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="20,8"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrandIndigoHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="20,7"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input - dark card background, separator border that turns green on keyboard focus. -->
    <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="CaretBrush"      Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="CaretBrush"      Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,6"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox - 16px retemplated box with a green check mark. -->
    <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M3.5 8.5 6.5 11.5 12.5 4.5" Stroke="{StaticResource AccentGreenBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox - full minimal retemplate (property-only styling leaves a white dropdown and
         light toggle chrome). Non-editable use only (IsEditable stays default false). -->
    <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Padding"    Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground"         Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Background"         Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush"        Value="{StaticResource SeparatorBrush}"/>
        <Setter Property="FontSize"           Value="13"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="{StaticResource CardBackgroundBrush}"
                                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                            CornerRadius="4">
                                        <Path Data="M7 10 12 15 17 10" Stroke="{StaticResource SecondaryTextBrush}"
                                              StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,10,0" Stretch="None"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,2,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indeterminate/marquee progress bar - hand-rolled because the stock indeterminate visual
         ignores Foreground recoloring. A ~30%-width green bar slides across a clipped track. -->
    <Style x:Key="MarqueeProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height"     Value="6"/>
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- Fixed-pixel sweep (TranslateTransform.X animates in pixels, and this
                         dictionary must stay code-free, so no width-fraction converter). All
                         consuming windows are fixed-size/NoResize, so a generous sweep range
                         covers every real track width; the clip hides any overshoot. -->
                    <Border x:Name="Track" Background="{TemplateBinding Background}"
                            CornerRadius="3" ClipToBounds="True">
                        <Border x:Name="Mover" Background="{TemplateBinding Foreground}"
                                CornerRadius="3" HorizontalAlignment="Left" Width="140">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MoverTransform" X="-140"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MoverTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-140" To="700" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only list (ListView + GridView) - flat dark header, no selection chrome. -->
    <Style x:Key="DarkGridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Background"          Value="{StaticResource HeaderBackgroundBrush}"/>
        <Setter Property="Foreground"          Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="FontSize"            Value="11"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="Padding"             Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Padding"    Value="10,5"/>
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border Background="Transparent"
                            BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkListViewStyle" TargetType="ListView">
        <Setter Property="Background"           Value="Transparent"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="Foreground"           Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="ItemContainerStyle"   Value="{StaticResource DarkListViewItemStyle}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

</ResourceDictionary>
