<UserControl x:Class="Support_Tool.Views.DebloaterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DebloaterPageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource PageBackgroundBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="InstalledItemRowTemplate" DataType="{x:Type vm:InstalledItemViewModel}">
            <Border Padding="12,8" CornerRadius="6" Margin="0,3"
                    ToolTip="{Binding Tooltip}" ToolTipService.IsEnabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                        <Border Background="{StaticResource IconPlaceholderBrush}" CornerRadius="8"
                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <Path Fill="{StaticResource IconPlaceholderFgBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-16v4h4V2h-4zm-6 4h4V2h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                        </Border>
                        <Image Source="{Binding Icon}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Version}" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding Version, Converter={StaticResource NullToVisibility}}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Publisher}" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{Binding Publisher, Converter={StaticResource NullToVisibility}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsHitTestVisible="False"/>
                </Grid>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                Padding="24,14,20,14"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Apps" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="Remove pre-installed Windows apps"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding SetGridViewCommand}" ToolTip="Grid view" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF18"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding ViewState.IsGridView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"
                              Stretch="Uniform" Width="14" Height="14">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewState.IsGridView}" Value="True">
                                            <Setter Property="Fill" Value="#1A1B28"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Command="{Binding SetListViewCommand}" ToolTip="List view">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ViewToggleButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFFFFF18"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding ViewState.IsListView}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"
                              Stretch="Uniform" Width="14" Height="14">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewState.IsListView}" Value="True">
                                            <Setter Property="Fill" Value="#1A1B28"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MODE BANNER -->
        <Border Grid.Row="1" Padding="24,7,24,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"      Value="#091508"/>
                    <Setter Property="BorderBrush"     Value="#1C4228"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewState.IsLiveMode}" Value="True">
                            <Setter Property="Background"  Value="#1A0808"/>
                            <Setter Property="BorderBrush" Value="#5A1A1A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ViewState.IsDryRun, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="DRY RUN MODE" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource AccentGreenBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="— No software will be removed" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ViewState.IsLiveMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="LIVE MODE" FontWeight="Bold" FontSize="11"
                               Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="— Selected software will be permanently removed" FontSize="11"
                               Foreground="#C07070" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOLBAR - search box always available (works against everything discovered so far,
             even mid-scan) and a small non-blocking discovery indicator. Deliberately never a
             full-page overlay - rows discovered so far stay visible and interactive the whole
             time a scan is still running. -->
        <Grid Grid.Row="2" Margin="24,10,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource CardBackgroundBrush}"
                         Foreground="{StaticResource PrimaryTextBrush}"
                         CaretBrush="{StaticResource PrimaryTextBrush}"
                         BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"
                         Padding="10,6" FontSize="13"/>
                <TextBlock Text="Search apps…" FontSize="13" Margin="12,0,0,0"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding DiscoveryStatusText}" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- CONTENT - shown as soon as discovery starts, not gated behind IsLoading, so rows
             appear incrementally as they're found instead of behind a blocking full-page wait. -->
        <Grid Grid.Row="3" x:Name="ContentArea"
              SizeChanged="ContentArea_SizeChanged">

            <!-- GRID VIEW -->
            <ScrollViewer x:Name="GridScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="GridScrollViewer_Loaded"
                          PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                          Visibility="{Binding ViewState.IsGridView, Converter={StaticResource BoolToVisibility}}"
                          Padding="12,8">
                <ItemsControl x:Name="GridItemsControl"
                              ItemsSource="{Binding ItemsView}"
                              ItemTemplate="{StaticResource InstalledItemRowTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="3,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- LIST VIEW -->
            <ListBox ItemsSource="{Binding ItemsView}"
                     ItemTemplate="{StaticResource InstalledItemRowTemplate}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                     Visibility="{Binding ViewState.IsListView, Converter={StaticResource BoolToVisibility}}"
                     Padding="12,8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="{StaticResource HeaderBackgroundBrush}" Padding="20,12"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <!-- Real determinate progress - CompletedItems/TotalItems is an honest known
                     numerator/denominator (the selected count never changes mid-batch), not an
                     animated placeholder. -->
                <StackPanel Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVisibility}}"
                            VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UninstallProgressPercent, Mode=OneWay}"
                                 Height="4" Margin="0,0,0,6"
                                 Foreground="{StaticResource AccentGreenBrush}"
                                 Background="{StaticResource SeparatorBrush}"/>
                    <TextBlock Text="{Binding UninstallProgressText}"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/>
                </StackPanel>
                <Grid Visibility="{Binding IsUninstalling, Converter={StaticResource InvertedBoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text="selected"/>
                        </TextBlock>
                        <Button Content="Uninstall Selected"
                                Command="{Binding UninstallCommand}"
                                Style="{StaticResource UninstallButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
