<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Account_Setup</RootNamespace>
    <AssemblyName>AccountSetup</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Toolkit.Shared\Images\favicon.ico</ApplicationIcon>
    <!-- Registers the DEVELOPMENT-ONLY Color configuration as valid at the solution level - see
         Toolkit.Shared.csproj's own matching property for why this is needed at all. -->
    <Configurations>Debug;Release;Color</Configurations>
  </PropertyGroup>

  <!-- DEVELOPMENT-ONLY build configuration for fast visual/theme iteration - never deployed, never
       published to X:\. See CLAUDE.md's "Color preview build" section. Debug-like build
       characteristics (unoptimized, full debug symbols) without defining DEBUG. asInvoker manifest
       avoids a UAC prompt on every dev/build/run iteration, since Program.cs's own #if COLOR
       early-return never reaches elevation/OOBE/Runtime-staging/Sysprep. -->
  <PropertyGroup Condition="'$(Configuration)'=='Color'">
    <DefineConstants>$(DefineConstants);COLOR</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Color'">
    <ApplicationManifest>app.color.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF removes the System.IO implicit using the WinForms-era build had (documented SDK
         behavior) - restore it so the many File/Path call sites keep compiling unchanged. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toolkit.Shared\Toolkit.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared brand theme, compiled into this assembly (Toolkit.Shared targets plain net10.0
         and cannot compile XAML itself) - merged in Program.cs via
         pack://application:,,,/Themes/ElkjopTheme.xaml -->
    <Page Include="..\Toolkit.Shared\Themes\ElkjopTheme.xaml" Link="Themes\ElkjopTheme.xaml" />
    <!-- Window icon (Window.Icon attribute) - same linked-resource shape as Support Tool -->
    <Resource Include="..\Toolkit.Shared\Images\favicon.ico" Link="Resources\favicon.ico" />
  </ItemGroup>

</Project>
