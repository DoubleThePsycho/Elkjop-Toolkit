<Window x:Class="Account_Setup.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Elkjøp - Account Setup"
        Icon="/Resources/favicon.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        Style="{DynamicResource ChromelessWindowStyle}"
        ContentRendered="Window_ContentRendered">
    <!-- Background/Style above use DynamicResource, not StaticResource: WPF resolves an
         element's own attribute properties before that same element's child-declared
         Window.Resources dictionary (below) has been populated, so a StaticResource here throws
         "Cannot find resource" at runtime - confirmed by actually running this after the
         Window.Resources merge was added. DynamicResource defers the lookup until after
         construction, resolving to the exact same brush/style either way; nothing nested inside
         this window's content is affected (Window.Resources is already populated by the time the
         Border/DockPanel content below is constructed, so every other {StaticResource ...} in
         this file is untouched). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Merged here (rather than only programmatically in Program.cs) so the Visual
                     Studio XAML designer - which never runs Program.cs's Main() - can also
                     resolve every {StaticResource ...} below and render the real shared theme
                     instead of unresolved-resource red-Xs/default white controls. This is now
                     the one source of truth for loading the theme into this window; Program.cs
                     no longer merges it into Application.Resources at all. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/ElkjopTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Small all-caps label above each input in the card below. -->
            <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin"     Value="0,14,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Thin outer window border - canonical shared shell resource (WindowBorderBrush), see
         ElkjopTheme.xaml's own remarks. -->
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
    <DockPanel LastChildFill="True">

        <!-- Custom titlebar (replaces the OS one - see ChromelessWindowStyle in ElkjopTheme.xaml).
             Background/separator are the canonical shared shell resources (WindowTitleBarBackgroundBrush/
             WindowTitleBarSeparatorBrush), not this page's own HeaderBackgroundBrush/SeparatorBrush. -->
        <Border DockPanel.Dock="Top" Height="{StaticResource TitleBarHeight}"
                Background="{StaticResource WindowTitleBarBackgroundBrush}"
                BorderBrush="{StaticResource WindowTitleBarSeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

    <StackPanel Margin="32,24,32,20">

        <!-- Header -->
        <TextBlock Text="Windows OOBE setup" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Create administrator account and choose display language."
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,18"/>

        <!-- Input card -->
        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="20,18">
            <StackPanel>

                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,6"/>
                <Grid>
                    <TextBox x:Name="usernameBox" Style="{StaticResource DarkTextBoxStyle}"
                             TextChanged="UsernameBox_TextChanged"/>
                    <TextBlock x:Name="usernameWatermark" Text="Username" IsHitTestVisible="False"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                               Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <TextBlock Text="PASSWORD (OPTIONAL)" Style="{StaticResource FieldLabelTextStyle}"/>
                <Grid>
                    <PasswordBox x:Name="passwordBox" Style="{StaticResource DarkPasswordBoxStyle}"
                                 MaxLength="127" Padding="8,6,36,6"
                                 PasswordChanged="PasswordInput_Changed"/>
                    <TextBox x:Name="passwordRevealBox" Style="{StaticResource DarkTextBoxStyle}"
                             MaxLength="127" Padding="8,6,36,6" Visibility="Collapsed"
                             TextChanged="PasswordInput_Changed"/>
                    <Button x:Name="revealButton" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            Width="30" Margin="0,1,1,1" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Focusable="False" Click="RevealButton_Click"
                            ToolTip="Show password">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path x:Name="revealGlyph" Data="{StaticResource EyeShowGlyph}" Width="18" Height="18"
                              Stretch="Uniform" Fill="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
                <Border x:Name="passwordErrorBorder" Height="2" Background="{StaticResource ErrorBrush}"
                        Margin="0,2,0,0" Visibility="Collapsed"/>

                <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabelTextStyle}"/>
                <PasswordBox x:Name="confirmPasswordBox" Style="{StaticResource DarkPasswordBoxStyle}"
                             MaxLength="127" PasswordChanged="PasswordInput_Changed"/>
                <Border x:Name="confirmPasswordErrorBorder" Height="2" Background="{StaticResource ErrorBrush}"
                        Margin="0,2,0,0" Visibility="Collapsed"/>

                <TextBlock Text="WINDOWS DISPLAY LANGUAGE" Style="{StaticResource FieldLabelTextStyle}"/>
                <ComboBox x:Name="languageCombo" Style="{StaticResource DarkComboBoxStyle}"
                          DisplayMemberPath="DisplayName" Height="32"/>

            </StackPanel>
        </Border>

        <!-- Fixed-locale note + Windows details -->
        <TextBlock Text="Keyboard and regional format: Norwegian (Bokmål) - fixed"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="2,12,0,0"/>
        <TextBlock x:Name="detailsText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                   Margin="2,2,0,0" TextTrimming="CharacterEllipsis"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="cancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" MinWidth="110" Margin="0,0,10,0"/>
            <Button x:Name="startButton" Content="Start setup" Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True" MinWidth="130" Click="StartButton_Click"/>
        </StackPanel>

    </StackPanel>
    </DockPanel>
    </Border>
</Window>
