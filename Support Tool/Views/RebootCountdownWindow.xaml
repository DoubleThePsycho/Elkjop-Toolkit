<Window x:Class="Support_Tool.Views.RebootCountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elkjøp - Restart required"
        Icon="/Resources/favicon.ico"
        Width="420" Height="240"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource ModalBodyBackgroundBrush}"
        Topmost="True"
        Style="{StaticResource ChromelessWindowStyle}">

    <!-- Cleanup pass: titlebar background/separator and the outer border are now the canonical
         shared shell resources (WindowTitleBarBackgroundBrush/WindowTitleBarSeparatorBrush/
         WindowBorderBrush) from ElkjopTheme.xaml - this modal is where those values originated,
         so nothing visually changes here, but Account Setup's SetupWindow now shares the exact
         same brushes/style under these role-based names instead of each window keeping its own
         copy. The former amber ModalWarningAccentBrush/warning strip is removed entirely (not
         replaced with another accent). ChromelessWindowStyle itself now also resolves to the
         shared, non-resizable variant from ElkjopTheme.xaml (this window was already NoResize,
         so nothing behavioral changes) rather than Support Tool's own resizable MainWindow style
         - no AllowsTransparency, no change to WindowChrome, native DWM shadow/Topmost/owner-
         dimming all unaffected. -->
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- Titlebar - close-only (no minimize/maximize), matching a simple modal dialog
                 rather than MainWindow's own resizable chrome. The close button behaves exactly
                 like Cancel: dismissing this dialog by any means must never be silently treated
                 as "proceed with reboot" - see code-behind's OnClosing override. -->
            <Border DockPanel.Dock="Top" Height="{StaticResource TitleBarHeight}"
                    Background="{StaticResource WindowTitleBarBackgroundBrush}"
                    BorderBrush="{StaticResource WindowTitleBarSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                           Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click">
                        <Path Data="M8,8 L18,18 M18,8 L8,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Restart required" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Text="Windows needs to restart to continue installing updates."
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                <TextBlock x:Name="CountdownText" Grid.Row="2" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click"
                            Style="{StaticResource UninstallButtonStyle}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
