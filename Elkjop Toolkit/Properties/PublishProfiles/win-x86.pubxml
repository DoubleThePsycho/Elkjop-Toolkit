<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <AssemblyName>Elkjop Toolkit</AssemblyName>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- Deliberately NOT nested under "...\Elkjop Toolkit\<ToolName>\" like every other
         published tool in this solution - Elkjop Toolkit.exe itself belongs at the top of the
         deployment layout, sibling to the "Elkjop Toolkit\" folder, exactly where setup.exe and
         service.exe used to sit (it looks for its targets at ".\Elkjop Toolkit\Account Setup\..."
         and ".\Elkjop Toolkit\Support Tool\..." relative to its own folder - see Program.cs). -->
    <PublishDir>bin\Release\net10.0-windows\publish\</PublishDir>
  </PropertyGroup>
</Project>
