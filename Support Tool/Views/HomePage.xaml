                    <Path Fill="#93d500">
                        <Path.Data>M416.9 93.8l-19.2 20.4c-8.4 8.6-13.3 20.1-13.7 32.2v1.8c0 4.4.6 8.7 1.7 12.9l1.4 4.4 40.5-41.2c10.6-10.5 10.6-27.6 0-38.2l-5-5-2.1-2.3a17.5 17.5 0 0 1-3.6 15m-31-89.5c-1.9 8.8-1.5 18 1 26.6 3.4 11.8 13 22.7 13 22.7l40 40.2c4.1 4.1 5.8 9.9 4.7 15.5l1.8-2 5.1-5c4.4-4.4 7.2-10.3 7.8-16.5.1-.8.1-1.7.1-2.5v-.2c0-7.1-2.9-14-7.9-19L386.7 0l-.8 4.3z</Path.Data>
                    </Path>
                </Canvas>
            </Viewbox>

            <!-- Title and version -->
            <TextBlock Text="Support Tool" TextAlignment="Center"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4"/>

            <TextBlock Text="{Binding AppVersion}" TextAlignment="Center"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <Rectangle Fill="{StaticResource DividerBrush}" Height="1" Margin="0,0,0,16"/>

            <TextBlock TextAlignment="Center" FontSize="13" LineHeight="22"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,36">
                A portable toolkit for removing pre-installed apps and managing
                installed programs on Elkjøp customer machines.
                All changes are reversible via system restore — dry run mode is on by default.
            </TextBlock>

            <!-- Quick-access cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding NavigateAppsCommand}"
                        Style="{StaticResource QuickCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource QuickCardIconBadgeStyle}">
                            <Path Style="{StaticResource QuickCardIconStyle}"
                                  Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
                        </Border>
                        <TextBlock Text="Apps" Style="{StaticResource QuickCardTitleTextStyle}"/>
                        <TextBlock Text="Remove pre-installed Windows apps" Style="{StaticResource QuickCardDescriptionTextStyle}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding NavigateProgramsCommand}"
                        Style="{StaticResource QuickCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource QuickCardIconBadgeStyle}">
                            <Path Style="{StaticResource QuickCardIconStyle}"
                                  Data="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                        </Border>
                        <TextBlock Text="Programs" Style="{StaticResource QuickCardTitleTextStyle}"/>
                        <TextBlock Text="Remove installed desktop programs" Style="{StaticResource QuickCardDescriptionTextStyle}"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
