<UserControl x:Class="Support_Tool.Views.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             xmlns:views="clr-namespace:Support_Tool.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProgramsPageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource WindowBackgroundBrush}">

    <!-- InstalledItemRowTemplate (grid/list card) now lives once, shared with DebloaterPage.xaml,
         in App.xaml's Application.Resources - see its own remarks for why. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorderStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Programs" Style="{StaticResource PageHeadingTextStyle}"/>
                    <TextBlock Text="Remove installed desktop programs" Style="{StaticResource PageSubtitleTextStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding SetGridViewCommand}" Tag="{Binding ViewState.IsGridView}" ToolTip="Grid view" Margin="0,0,4,0"
                            Style="{StaticResource ViewToggleButtonStyle}">
                        <Path Style="{StaticResource ViewToggleIconStyle}" Data="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z"/>
                    </Button>
                    <Button Command="{Binding SetListViewCommand}" Tag="{Binding ViewState.IsListView}" ToolTip="List view"
                            Style="{StaticResource ViewToggleButtonStyle}">
                        <Path Style="{StaticResource ViewToggleIconStyle}" Data="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <views:DryRunIndicator Grid.Row="1"/>

        <!-- TOOLBAR - search box always available (works against everything discovered so far,
             even mid-scan) and a small non-blocking discovery indicator. Deliberately never a
             full-page overlay - rows discovered so far stay visible and interactive the whole
             time a scan is still running. -->
        <Grid Grid.Row="2" Margin="24,10,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBoxStyle}"/>
                <TextBlock Text="Search programs…" Style="{StaticResource SearchWatermarkTextStyle}"
                           Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding DiscoveryStatusText}" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- CONTENT - shown as soon as discovery starts, not gated behind IsLoading, so rows
             appear incrementally as they're found instead of behind a blocking full-page wait. -->
        <Grid Grid.Row="3" x:Name="ContentArea"
              SizeChanged="ContentArea_SizeChanged">

            <!-- GRID VIEW -->
            <ScrollViewer x:Name="GridScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="GridScrollViewer_Loaded"
                          PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                          Visibility="{Binding ViewState.IsGridView, Converter={StaticResource BoolToVisibility}}"
                          Padding="12,8">
                <!-- WrapPanel, not UniformGrid (external review): UniformGrid was reserving cell
                     height based on the full available viewport instead of packing rows from the
                     top when there are only a few items, so a sparse Programs list rendered a
                     couple of oversized rows filling most of the page. WrapPanel's own ItemWidth
                     (set from GridColumnHelper in code-behind, applies uniformly to every child
                     including ones added later as discovery streams in) keeps the same
                     grid-like, responsive-column look, but a WrapPanel by construction never
                     stretches vertically to fill leftover space - it is always exactly as tall as
                     the rows it actually needs. -->
                <ItemsControl x:Name="GridItemsControl"
                              VerticalAlignment="Top"
                              ItemsSource="{Binding ItemsView}"
                              ItemTemplate="{StaticResource InstalledItemRowTemplate}"
                              ItemContainerStyle="{StaticResource CardGridItemContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- LIST VIEW -->
            <ListBox ItemsSource="{Binding ItemsView}"
                     ItemTemplate="{StaticResource InstalledItemRowTemplate}"
                     ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                     Visibility="{Binding ViewState.IsListView, Converter={StaticResource BoolToVisibility}}"
                     Padding="12,8"/>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="4" Style="{StaticResource FooterBarBorderStyle}">
            <Grid>
                <!-- Real determinate progress - CompletedItems/TotalItems is an honest known
                     numerator/denominator (the selected count never changes mid-batch), not an
                     animated placeholder. -->
                <StackPanel Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVisibility}}"
                            VerticalAlignment="Center">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding UninstallProgressPercent, Mode=OneWay}"
                                 Margin="0,0,0,6" Style="{StaticResource ThinProgressBarStyle}"/>
                    <TextBlock Text="{Binding UninstallProgressText}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                </StackPanel>
                <Grid Visibility="{Binding IsUninstalling, Converter={StaticResource InvertedBoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text="selected"/>
                        </TextBlock>
                        <Button Content="Uninstall Selected"
                                Command="{Binding UninstallCommand}"
                                Style="{StaticResource UninstallButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
