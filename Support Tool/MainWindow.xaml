<Window x:Class="Support_Tool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Support_Tool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
        Title="Elkjøp - Support Tool"
        Icon="Resources/favicon.ico"
        Height="700" Width="1050"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBackgroundBrush}"
        Style="{StaticResource ResizableChromelessWindowStyle}">

    <Window.Resources>
        <!-- One sidebar navigation entry: transparent by default, NavigationHoverBrush on hover,
             and NavigationHoverBrush plus a 3px NavigationActiveBrush left accent while it's the
             active page. Each entry binds Tag to its own MainViewModel "is this page active"
             flag (e.g. Tag="{Binding IsAppsPage}") - that is the only per-entry state input.
             Padding is overridable per entry (Settings uses a taller one). -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding"     Value="17,12,20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavigationHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background"  Value="{StaticResource NavigationHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NavigationActiveBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarNavIconStyle" TargetType="Path">
            <Setter Property="Width"             Value="16"/>
            <Setter Property="Height"            Value="16"/>
            <Setter Property="Stretch"           Value="Uniform"/>
            <Setter Property="Fill"              Value="White"/>
            <Setter Property="Margin"            Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SidebarNavLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="White"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- "WORKFLOWS" / "TOOLS" group headings -->
        <Style x:Key="SidebarSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="22,10,0,2"/>
        </Style>
    </Window.Resources>

    <!-- Thin outer window border - canonical shared shell resource (WindowBorderBrush), see
         ElkjopTheme.xaml's own remarks. -->
    <Border BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom titlebar (replaces the OS one - see ResizableChromelessWindowStyle in
             App.xaml). Resizable/maximizable, unlike Account Setup's own close-only chrome, so
             it needs its own minimize/maximize-restore/close buttons rather than reusing theirs.
             Background/separator are the canonical shared shell resources
             (WindowTitleBarBackgroundBrush/WindowTitleBarSeparatorBrush), not this window's own
             brand-indigo sidebar color. -->
        <Border Grid.Row="0" Height="{StaticResource TitleBarHeight}"
                Background="{StaticResource WindowTitleBarBackgroundBrush}"
                BorderBrush="{StaticResource WindowTitleBarSeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>

                <Button Grid.Column="2" Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click">
                    <Path Width="10" Height="10" Stretch="None" Data="M0,5 H10"
                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1"/>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestore_Click">
                    <Grid Width="10" Height="10">
                        <Path x:Name="MaximizeIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1"/>
                        <Path x:Name="RestoreIcon" Visibility="Collapsed"
                              Data="M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z"
                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1"/>
                    </Grid>
                </Button>

                <Button Grid.Column="4" Style="{StaticResource TitleBarCloseButtonStyle}" Click="Close_Click">
                    <Path Data="M8,8 L18,18 M18,8 L8,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>

        <!-- Body: sidebar + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar. Entries are listed top to bottom in declaration order; Dock="Bottom"
                 entries stack upward from the bottom edge in declaration order, so the first
                 Dock="Bottom" child (the Separator) is the bottom-most one. -->
            <DockPanel Grid.Column="0" Background="{StaticResource NavigationBackgroundBrush}" LastChildFill="False">

                <!-- Logo (navigates to Home) -->
                <Button DockPanel.Dock="Top"
                        Command="{Binding NavigateHomeCommand}"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="LogoBorder" Background="Transparent"
                                    Padding="20,12,20,12">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover-only now - the real Home nav entry just below (added
                                     alongside this logo) is what shows the active-page state;
                                     this button no longer doubles as an active-page indicator, so
                                     it stays transparent while Home is active unless actually
                                     hovered. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="LogoBorder" Property="Background" Value="{StaticResource NavigationHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Viewbox Width="145" Stretch="Uniform">
                        <Canvas Width="459.5" Height="165.7">
                            <Path Fill="White">
                                <Path.Data>M225.1 93.4V50.6h-7.4c-3.9.1-7 3.3-7 7.2v35c0 7.6-3.4 10.8-9 10.8-3.3 0-5.8-1.1-8.7-3.3-1.2-1-2.7-1.5-4.3-1.5-3.8 0-6.8 3-6.8 6.8v.1c0 2.2 1 4.2 2.7 5.5 5 3.8 11.1 5.8 17.3 5.7 7.1 0 13-2.1 17-6.1s6.1-9.6 6.2-17.4m-50.5-31.3L154 83.3l20.6 21.3c2.8 2.7 2.9 7.1.2 9.9l-.2.2c-2.8 2.7-7.2 2.6-9.9-.2l-29.6-31.2 29.6-31.2c2.7-2.8 7.1-2.9 9.9-.2l.2.2c2.7 2.8 2.6 7.2-.2 10 0-.1 0-.1 0 0m-39.9 47.6c0 3.5-3.1 6.3-7.1 6.3h-7.1V57.7c0-3.8 3-7 6.8-7.1h7.4v59.1zm236.4-36.3v-.2c0-13.4-9.5-22.7-25.1-22.7h-19.5c-3.9 0-7.2 3.1-7.2 7.1V116h7.3c3.8 0 7.1-2.8 7.1-6.3v-46h13.1c6.1.6 9.8 4 9.8 9.8v.2c0 5.2-3.6 9.2-9.8 9.9h-.1c-4.7 0-8.6 3.9-8.6 8.6v4.2h6.5l3.2-.1c13.1-1.1 23.3-8.9 23.3-22.9M110.2 103H77V50.6h-7.4c-3.9.1-7 3.3-7 7.2v58.3h41.1c3.6 0 6.5-2.8 6.6-6.4l-.1-6.7zM14.3 103h36.1v6.7c0 3.5-2.9 6.4-6.4 6.4H0V57.8c0-3.9 3.2-7.2 7.1-7.2h43.3V57c0 3.5-2.8 6.4-6.3 6.4H14.3v13.3h25c3.6 0 6.4 2.9 6.5 6.5 0 3.5-2.9 6.4-6.4 6.4h-25l-.1 13.4zM304.9 70.2c-.9-2-1.9-3.9-3.2-5.6-.1-.1-1.6-2.3-1.6-2.3l-5.6 5.6c-1.9 1.8-2.5 4.6-1.5 7.1 4.4 10.9-.8 23.3-11.7 27.7-5.1 2.1-10.9 2.1-16 0-2.7-1.1-5.7-.3-7.5 2-1.3 1.2-5.2 5.2-5.2 5.2 2.3 1.9 4.8 3.4 7.5 4.7l.3.2c17.5 7.1 37.4-1.3 44.6-18.8 1.7-4.1 2.5-8.5 2.5-13 .1-4.4-.8-8.8-2.6-12.8m-51.3 20.9c-4.4-10.9.8-23.3 11.7-27.7 5.1-2.1 10.9-2.1 16 0 2.5 1 5.3.4 7.1-1.5l5.6-5.6c-2.2-1.8-4.6-3.3-7.2-4.6l-.6-.3c-17.5-7.1-37.5 1.3-44.6 18.8-3.4 8.3-3.4 17.5 0 25.8.1.4.4 1 .6 1.4 1.3 2.2 2.7 4.4 4.2 6.4l5.1-5.1c.9-.7 1.6-1.6 2-2.6.7-1.5.7-3.4.1-5</Path.Data>
                            </Path>
                            <Path Fill="#93d500">
                                <Path.Data>M416.9 93.8l-19.2 20.4c-8.4 8.6-13.3 20.1-13.7 32.2v1.8c0 4.4.6 8.7 1.7 12.9l1.4 4.4 40.5-41.2c10.6-10.5 10.6-27.6 0-38.2l-5-5-2.1-2.3a17.5 17.5 0 0 1-3.6 15m-31-89.5c-1.9 8.8-1.5 18 1 26.6 3.4 11.8 13 22.7 13 22.7l40 40.2c4.1 4.1 5.8 9.9 4.7 15.5l1.8-2 5.1-5c4.4-4.4 7.2-10.3 7.8-16.5.1-.8.1-1.7.1-2.5v-.2c0-7.1-2.9-14-7.9-19L386.7 0l-.8 4.3z</Path.Data>
                            </Path>
                            <Canvas>
                                <Canvas.Clip>
                                    <PathGeometry FillRule="Nonzero"
                                        Figures="M416.9 93.8l-19.2 20.4c-8.4 8.6-13.3 20.1-13.7 32.2v1.8c0 4.4.6 8.7 1.7 12.9l1.4 4.4 40.5-41.2c10.5-10.5 10.5-27.6 0-38.2l-5-5-2.1-2.3c1.2 5.4-.1 10.9-3.6 15Z"/>
                                </Canvas.Clip>
                                <Path Data="M342.3 134l60.8-80.1 74.9 56.8-60.9 80.1z">
                                    <Path.Fill>
                                        <LinearGradientBrush MappingMode="Absolute"
                                            StartPoint="375.782,167.621" EndPoint="430.384,95.685">
                                            <GradientStop Color="#00006D46" Offset="0"/>
                                            <GradientStop Color="#0D006D46" Offset="0.17"/>
                                            <GradientStop Color="#2E006D46" Offset="0.37"/>
                                            <GradientStop Color="#69006D46" Offset="0.59"/>
                                            <GradientStop Color="#B8006D46" Offset="0.83"/>
                                            <GradientStop Color="#FF006D46" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                            </Canvas>
                            <Canvas>
                                <Canvas.Clip>
                                    <PathGeometry FillRule="Nonzero"
                                        Figures="M385.9 4.3c-1.9 8.8-1.5 18 1 26.6 3.4 11.8 13 22.7 13 22.7l40 40.2c4.1 4.1 5.8 9.9 4.7 15.5l1.8-2 5.1-5.1c4.4-4.4 7.2-10.3 7.8-16.5.1-.8.1-1.7.1-2.5V83c0-7.1-2.9-14-7.9-19L386.7 0l-.8 4.3Z"/>
                                </Canvas.Clip>
                                <Path Data="M328.5 47.1L426.4-38l87.2 100.3-97.9 85.1z">
                                    <Path.Fill>
                                        <LinearGradientBrush MappingMode="Absolute"
                                            StartPoint="448.666,86.448" EndPoint="393.265,22.717">
                                            <GradientStop Color="#00006D46" Offset="0"/>
                                            <GradientStop Color="#0D006D46" Offset="0.17"/>
                                            <GradientStop Color="#2E006D46" Offset="0.37"/>
                                            <GradientStop Color="#69006D46" Offset="0.59"/>
                                            <GradientStop Color="#B8006D46" Offset="0.83"/>
                                            <GradientStop Color="#FF006D46" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Separator DockPanel.Dock="Top" Background="{StaticResource NavigationHoverBrush}" Margin="16,0,16,0"/>

                <!-- Home - a real, always-visible nav entry near the top of the primary
                     navigation (the clickable logo above still also navigates Home, but is no
                     longer the ONLY discoverable way to get there). Workflow-aware, same as the
                     logo: Setup -> SetupHomePageViewModel, Service -> the existing generic
                     HomePageViewModel (see MainViewModel.NavigateHomeCommand). Highlights for
                     EITHER destination via IsHomeNavigationActive, never for the raw Install page. -->
                <Button DockPanel.Dock="Top" Margin="0,8,0,0" Style="{StaticResource SidebarNavButtonStyle}"
                        Command="{Binding NavigateHomeCommand}" Tag="{Binding IsHomeNavigationActive}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SidebarNavIconStyle}"
                              Data="M12 3 2 12h3v8h6v-6h2v6h6v-8h3z"/>
                        <TextBlock Text="Home" Style="{StaticResource SidebarNavLabelStyle}"/>
                    </StackPanel>
                </Button>

                <!-- WORKFLOWS group. Setup has no nav button here - it's a workflow identity and
                     a startup-time routing/mandatory-gate decision (App.xaml.cs navigates a
                     Setup session straight to whichever page its persisted Stage means - Windows
                     Update, then eventually Install), not a page a technician clicks into. -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">

                    <TextBlock Text="WORKFLOWS" Style="{StaticResource SidebarSectionLabelStyle}"/>

                    <!-- Service -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Command="{Binding NavigateServiceCommand}" Tag="{Binding IsServicePage}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SidebarNavIconStyle}"
                                  Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.2L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
                            <TextBlock Text="Service" Style="{StaticResource SidebarNavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- TOOLS group -->
                <StackPanel DockPanel.Dock="Top" Margin="0,4,0,0">

                    <TextBlock Text="TOOLS" Style="{StaticResource SidebarSectionLabelStyle}"/>

                    <!-- Install -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Command="{Binding NavigateInstallCommand}" Tag="{Binding IsInstallPage}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SidebarNavIconStyle}"
                                  Data="M12 2a1 1 0 0 1 1 1v11.59l3.29-3.3a1 1 0 1 1 1.42 1.42l-5 5a1 1 0 0 1-1.42 0l-5-5a1 1 0 1 1 1.42-1.42L11 14.59V3a1 1 0 0 1 1-1zM4 19a1 1 0 0 0 0 2h16a1 1 0 0 0 0-2H4z"/>
                            <TextBlock Text="Install" Style="{StaticResource SidebarNavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Windows Update - the one real standalone page, used identically by Setup
                         (auto-started, navigated to directly at startup) and Service (manual,
                         also reachable via the card on the Service page itself). -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Command="{Binding NavigateWindowsUpdateCommand}" Tag="{Binding IsWindowsUpdatePage}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SidebarNavIconStyle}"
                                  Data="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm1 5v5.41l3.29 3.3-1.42 1.42L11 13.83V7Z"/>
                            <TextBlock Text="Windows Update" Style="{StaticResource SidebarNavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Apps -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Command="{Binding NavigateAppsCommand}" Tag="{Binding IsAppsPage}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SidebarNavIconStyle}"
                                  Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
                            <TextBlock Text="Apps" Style="{StaticResource SidebarNavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <!-- Programs -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                            Command="{Binding NavigateProgramsCommand}" Tag="{Binding IsProgramsPage}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource SidebarNavIconStyle}"
                                  Data="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                            <TextBlock Text="Programs" Style="{StaticResource SidebarNavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Settings pinned to bottom (taller padding than the other entries). -->
                <Separator DockPanel.Dock="Bottom" Background="{StaticResource NavigationHoverBrush}" Margin="16,0,16,0"/>
                <Button DockPanel.Dock="Bottom" Padding="17,14,20,14" Style="{StaticResource SidebarNavButtonStyle}"
                        Command="{Binding NavigateSettingsCommand}" Tag="{Binding IsSettingsPage}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SidebarNavIconStyle}"
                              Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.57 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                        <TextBlock Text="Settings" Style="{StaticResource SidebarNavLabelStyle}"/>
                    </StackPanel>
                </Button>

            </DockPanel>

            <!-- Content area -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"/>

        </Grid>

        <!-- Persistent activity footers - stacked (not overlapping) so Windows Update and an
             install batch can both be active and visible at the same time; each is completely
             independent and simply contributes zero height while its own Visibility is
             Collapsed, so 0/1/2 rows show automatically with no extra layout logic needed. -->
        <StackPanel Grid.Row="2">

            <!-- Persistent Windows Update footer - follows the technician across every other page
                 while a run is active/needs attention (MainViewModel.ShowWindowsUpdateFooter), so
                 navigating away from the Windows Update page never means losing track of it. Binds
                 directly into the same shared WindowsUpdatePage ViewModel the full page itself
                 uses - no separate polling, no second WUA engine. -->
            <Border Style="{StaticResource FooterBarBorderStyle}" Padding="20,10"
                    Visibility="{Binding ShowWindowsUpdateFooter, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding WindowsUpdatePage}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Semantic, not permanently "success" green - neutral for
                         idle/running/up-to-date/navigation, warning only when a reboot is
                         genuinely pending (or connectivity is blocking progress), error only on a
                         genuine failure. Never shows a warning treatment merely because it
                         represents Windows Update (see App.xaml's semantic icon brush remarks). -->
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource IconPlaceholderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorIconBgBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRebootDeferred}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNoConnection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Path Stretch="Uniform" Width="14" Height="14"
                              Data="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm1 5v5.41l3.29 3.3-1.42 1.42L11 13.83V7Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource IconPlaceholderFgBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource ErrorIconBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRebootDeferred}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNoConnection}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                        <TextBlock Text="Windows Update" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding FooterStatusText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding ProgressSummaryText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                    <!-- Same aggregate percentage as the full Windows Update page's own overall
                         bar - one calculation, two bound displays (see
                         WindowsUpdateProgressBarStyle in App.xaml). Indeterminate until real rows
                         exist. -->
                    <ProgressBar Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0"
                                 Style="{StaticResource WindowsUpdateProgressBarStyle}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Grid.Column="4" Content="Reboot now" Margin="0,0,10,0"
                            Command="{Binding RebootNowCommand}"
                            Visibility="{Binding IsRebootDeferred, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource UninstallButtonStyle}"/>

                    <Button Grid.Column="5" Content="View"
                            Command="{Binding DataContext.NavigateWindowsUpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource UninstallButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Persistent Install footer - same pattern as Windows Update's own footer above,
                 following the technician across other pages while an install batch is active
                 (MainViewModel.ShowInstallFooter), hidden while they're already looking at the
                 full Install page. Binds into the same long-lived InstallPageViewModel the page
                 itself uses - no second install engine, no polling. Real determinate progress,
                 not an animated placeholder. -->
            <Border Style="{StaticResource FooterBarBorderStyle}" Padding="20,10"
                    Visibility="{Binding ShowInstallFooter, Converter={StaticResource BoolToVisibility}}">
                <Grid DataContext="{Binding InstallPage}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Neutral, not permanently green - this icon just represents "an install is
                         in progress" (informational), not a success/warning/error state, so it
                         gets the same neutral treatment as ordinary navigation icons (see
                         App.xaml's semantic icon brush remarks). -->
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                            Background="{StaticResource IconPlaceholderBrush}" VerticalAlignment="Center">
                        <Path Fill="{StaticResource IconPlaceholderFgBrush}" Stretch="Uniform" Width="14" Height="14"
                              Data="M12 2a1 1 0 0 1 1 1v11.59l3.29-3.3a1 1 0 1 1 1.42 1.42l-5 5a1 1 0 0 1-1.42 0l-5-5a1 1 0 1 1 1.42-1.42L11 14.59V3a1 1 0 0 1 1-1zM4 19a1 1 0 0 0 0 2h16a1 1 0 0 0 0-2H4z"/>
                    </Border>

                    <TextBlock Grid.Column="1" Text="Installing applications" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="12,0,16,0"/>

                    <TextBlock Grid.Column="2" Text="{Binding InstallProgressText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0"
                                 Minimum="0" Maximum="100" Value="{Binding InstallProgressPercent, Mode=OneWay}"
                                 Style="{StaticResource ThinProgressBarStyle}"/>

                    <Button Grid.Column="4" Content="View"
                            Command="{Binding DataContext.NavigateInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource UninstallButtonStyle}"/>
                </Grid>
            </Border>

        </StackPanel>

        <!-- Phase 5: dims the main window while a restart-critical modal (RebootCountdownWindow)
             is open, via MainWindow.SetModalDimmed - declared LAST so it renders on top of every
             other child in z-order. Collapsed by default (contributes nothing when not shown);
             the modal itself is never dimmed, only this window. See
             WindowsUpdateLifecycleCoordinator.ShowRebootCountdownAndConfirm for the
             show/try-finally-hide wiring that guarantees this always clears again. -->
        <Border x:Name="ModalDimOverlay" Grid.Row="0" Grid.RowSpan="3"
                Background="#70000000" Visibility="Collapsed" IsHitTestVisible="True"/>

    </Grid>
    </Border>
</Window>
