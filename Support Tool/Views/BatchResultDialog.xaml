<Window x:Class="Support_Tool.Views.BatchResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Support_Tool.Models"
        Title="{Binding Title, StringFormat='Elkjøp - {0}'}"
        Width="460" SizeToContent="Height"
        MinWidth="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + heading - a single glance answer to "did this go fine". -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="{StaticResource IconPlaceholderBrush}" Margin="0,0,12,0">
                <Path Stretch="Uniform" Width="18" Height="18">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Data" Value="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm4.59 3.58L10 14.17l-2.59-2.58L6 13l4 4 8-8-1.41-1.42Z"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Border>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Counts - the "did this go fine" answer at a glance, no scrolling needed. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Counts}" Margin="0,0,0,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ResultCountLine}">
                    <Grid Margin="0,2">
                        <TextBlock Text="{Binding Label}" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Count}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Details header - only present when there's something worth listing. -->
        <TextBlock Grid.Row="2" Text="Details" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,6"
                   Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Scrollable concise details - never raw WinGet/PowerShell/Revo output, see
             BatchResultSummary's own remarks. Capped height so 30 lines can't blow up the
             window; a handful of failures/warnings/skips reads comfortably without scrolling. -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                CornerRadius="4" Padding="12,8" MaxHeight="220"
                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4" Content="OK" Click="OkButton_Click"
                Style="{StaticResource UninstallButtonStyle}"
                HorizontalAlignment="Right" MinWidth="90" Margin="0,20,0,0"/>
    </Grid>
</Window>
