<UserControl x:Class="Support_Tool.Views.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             xmlns:views="clr-namespace:Support_Tool.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstallPageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <!-- Install/Update pill switch in the page header - same Tag-bound active-state pattern
             as the shared ViewToggleButtonStyle (App.xaml, used by DebloaterPage/ProgramsPage's
             grid/list toggle), but text-labeled and Auto-width rather than a fixed-size icon
             square, so it's kept local to this page rather than promoted to App.xaml - nowhere
             else in the app needs a text pill. Bind Tag to the matching IsInstallTabActive/
             IsUpdateTabActive flag. -->
        <Style x:Key="PageTabButtonStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding"          Value="16,6"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF"/>
                </Trigger>
                <!-- Declared after IsMouseOver so the active fill wins while hovered. -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground"  Value="#1A1B28"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Update tab row - same Name|Status|Progress shape as WindowsUpdatePage's own
             UpdateRowTemplate, kept as an independent copy rather than a shared App.xaml template:
             the two bind to genuinely different ViewModel types (AppUpdateRowViewModel here,
             UpdateRowViewModel there - see AppUpdateRowViewModel's own remarks for why they are
             not the same type), so sharing one DataTemplate isn't possible without first unifying
             those types, which would be a larger, unrelated change. -->
        <DataTemplate x:Key="AppUpdateRowTemplate" DataType="{x:Type vm:AppUpdateRowViewModel}">
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Value="1">
                                <DataTrigger.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}" Path="(ItemsControl.AlternationIndex)"/>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Border Grid.Column="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                        <TextBlock Text="{Binding StateText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                        <TextBlock Text="{Binding PercentText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Setup profiles resources - moved here from SetupHomePage.xaml (external review:
             browser/SA Standard/SA Gaming selection now lives on Install, its canonical location). -->
        <Style x:Key="PresetCardButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="InstallableAppCardTemplate" DataType="{x:Type vm:InstallableAppViewModel}">
            <Border Padding="12,8" CornerRadius="6" Margin="0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                        <Border Background="{StaticResource IconPlaceholderBrush}" CornerRadius="8"
                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <Path Fill="{StaticResource IconPlaceholderFgBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-16v4h4V2h-4zm-6 4h4V2h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                        </Border>
                        <Image Source="{Binding Icon}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Installed">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="UpdateAvailable">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsHitTestVisible="False"/>
                </Grid>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="InstallCategoryTemplate" DataType="{x:Type vm:InstallCategoryViewModel}">
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="9,4,0,8">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Cursor="Hand"
                                Visibility="{Binding ShowSelectAll, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox IsThreeState="True"
                                  IsChecked="{Binding SelectAllState, Mode=OneWay}"
                                  Command="{Binding SelectAllCommand}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Select all" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ItemsControl x:Name="CategoryGrid"
                              ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource InstallableAppCardTemplate}"
                              ItemContainerStyle="{StaticResource CardGridItemContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBorderStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Applications" Style="{StaticResource PageHeadingTextStyle}"/>
                    <TextBlock Text="Install and update applications via winget" Style="{StaticResource PageSubtitleTextStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Install" Command="{Binding SelectInstallTabCommand}"
                            Tag="{Binding IsInstallTabActive}" Style="{StaticResource PageTabButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="Update" Command="{Binding SelectUpdateTabCommand}"
                            Tag="{Binding IsUpdateTabActive}" Style="{StaticResource PageTabButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <views:DryRunIndicator Grid.Row="1"/>

        <!-- INSTALL TAB - everything below was the page's whole content before the Update tab
             existed; wrapped in one Visibility gate (IsInstallTabActive) rather than restructured,
             so every existing state/binding inside is untouched. -->
        <Grid Grid.Row="2" Visibility="{Binding IsInstallTabActive, Converter={StaticResource BoolToVisibility}}">

        <!-- PREPARING WINGET - a distinct full-page state, never the small footer. WinGet
             preparation (check/repair/verify) can take real time and genuinely mutate the
             machine, so it gets the same prominence a real loading state deserves rather than
             being squeezed into a status line under the generic "Checking available
             applications..." spinner. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480"
                    Visibility="{Binding IsPreparingPrerequisite, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Preparing WinGet" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
            <ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Center" Margin="0,0,0,16"
                         Style="{StaticResource ThinProgressBarStyle}"/>

            <!-- Live scrolling detail - real streamed WinGet repair output (our own stage
                 markers plus Repair-WinGetPackageManager's own cleaned verbose lines), so the
                 technician sees actual evidence of activity during a repair that can genuinely
                 take real minutes, not just an indeterminate bar that could mean anything. -->
            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                    Visibility="{Binding PrerequisiteDetailText, Converter={StaticResource NullToVisibility}}">
                <ScrollViewer x:Name="PrerequisiteDetailScrollViewer" Height="180"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                    <TextBlock Text="{Binding PrerequisiteDetailText}" FontFamily="Consolas"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- LOADING CATALOG - only reached once WinGet is positively confirmed ready. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoadingCatalog, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar IsIndeterminate="True" Width="220"
                         Style="{StaticResource ThinProgressBarStyle}"/>
            <TextBlock Text="Checking available applications…" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- LOAD FAILED - either WinGet couldn't be prepared, or the catalog itself failed to
             load after WinGet was confirmed ready. No app cards, no install footer, no raw
             PowerShell/CLIXML output - just a clean human-readable reason and a way to retry. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                    Visibility="{Binding IsLoadFailed, Converter={StaticResource BoolToVisibility}}">
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="{StaticResource ErrorIconBgBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <Path Fill="{StaticResource ErrorIconBrush}" Stretch="Uniform" Width="22" Height="22"
                      Data="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
            </Border>
            <TextBlock Text="{Binding LoadErrorHeading}" FontSize="16" FontWeight="SemiBold"
                       TextAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding LoadErrorMessage}" FontSize="13" TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>
            <Button Content="Retry" Command="{Binding RetryCommand}"
                    Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- CATALOG READY (grid-only). Visible - and usable - the moment WinGet is ready, not once
             every app's status is known: categories/cards stream in incrementally while this is
             shown (see InstallPageViewModel.LoadCoreAsync), so an already-added card stays fully
             selectable while others are still loading. -->
        <Grid x:Name="ContentArea"
              SizeChanged="ContentArea_SizeChanged"
              Visibility="{Binding IsCatalogReady, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="GridScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          Loaded="GridScrollViewer_Loaded"
                          PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                          Padding="12,8">
                <StackPanel>
                    <!-- SETUP PROFILES - SA Standard/SA Gaming presets (moved here from a
                         separate always-visible region - external review: they now scroll away
                         together with the Applications catalog below, instead of consuming fixed
                         vertical space above it. The old top browser-selector strip is gone
                         entirely - Firefox is the fixed default these profiles merge in
                         (InstallPageViewModel.SelectedBrowser's own existing fallback
                         resolution), and the technician can still change the actual browser
                         selection via the real Browsers category checkboxes below, exactly like
                         any other catalog row.) -->
                    <StackPanel Margin="0,2,0,16">
                        <TextBlock Text="Setup profiles" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="9,0,0,10"/>

                        <WrapPanel Orientation="Horizontal" Margin="9,0,0,4">
                            <Button Style="{StaticResource PresetCardButtonStyle}"
                                    Command="{Binding ApplyStandardCommand}"
                                    Width="300" MinWidth="260" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="SA Standard" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Firefox, Java 8, Spotify, VLC" FontSize="12"
                                               TextWrapping="Wrap" LineHeight="17"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PresetCardButtonStyle}"
                                    Command="{Binding ApplyGamingCommand}"
                                    Width="300" MinWidth="260" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="SA Gaming" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Standard + Discord + game launchers" FontSize="12"
                                               TextWrapping="Wrap" LineHeight="17"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Text="Applications" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="9,2,0,8"/>
                    <ItemsControl x:Name="CategoriesControl"
                                  ItemsSource="{Binding Categories}"
                                  ItemTemplate="{StaticResource InstallCategoryTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Small non-blocking indicator - never a full-page overlay - while apps are still
                 being discovered incrementally. -->
            <Border Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="4"
                    Padding="10,5" Margin="0,10,16,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Visibility="{Binding IsPopulatingCatalog, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CatalogPopulationStatusText}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </Grid>

        </Grid>

        <!-- UPDATE TAB - independent content/states from the Install tab above. Uses its own
             inline footer-like bar (Grid.Row="1" below) rather than the page's shared
             Grid.Row="3" footer, which stays Install-specific (see IsInstallFooterVisible) since
             its bindings/commands are all Install-selection-specific. -->
        <Grid Grid.Row="2" Visibility="{Binding IsUpdateTabActive, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CHECKING -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsCheckingForAppUpdates, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar IsIndeterminate="True" Width="220" Style="{StaticResource ThinProgressBarStyle}"/>
                <TextBlock Text="Checking for application updates…" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- CHECK FAILED -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding IsAppUpdateCheckFailed, Converter={StaticResource BoolToVisibility}}">
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource ErrorIconBgBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Fill="{StaticResource ErrorIconBrush}" Stretch="Uniform" Width="22" Height="22"
                          Data="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                </Border>
                <TextBlock Text="Could not check for application updates" FontSize="16" FontWeight="SemiBold"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding UpdateLoadErrorMessage}" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                <Button Content="Retry" Command="{Binding CheckForAppUpdatesCommand}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- UP TO DATE (Ready, zero rows) -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding HasNoAppUpdates, Converter={StaticResource BoolToVisibility}}">
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource SuccessBackgroundBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Fill="{StaticResource SuccessBrush}" Stretch="Uniform" Width="22" Height="22"
                          Data="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm4.59 3.58L10 14.17l-2.59-2.58L6 13l4 4 8-8-1.41-1.42Z"/>
                </Border>
                <TextBlock Text="All applications are up to date" FontSize="14" FontWeight="SemiBold"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                <Button Content="Check again" Command="{Binding CheckForAppUpdatesCommand}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- HAS UPDATES (Ready, &gt;0 rows) - same Name|Status|Progress grid shape as
                 WindowsUpdatePage. -->
            <Grid Grid.Row="0" Margin="20,16,20,16"
                  Visibility="{Binding HasAppUpdates, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Application" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Grid.Column="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                        <TextBlock Text="Status" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                        <TextBlock Text="Progress" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding UpdateRows}" ItemTemplate="{StaticResource AppUpdateRowTemplate}"
                                      AlternationCount="2"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Update tab's own footer-like bar - only while there's actually something to
                 update (HasAppUpdates), including while a batch is actively running. -->
            <Border Grid.Row="1" Style="{StaticResource FooterBarBorderStyle}"
                    Visibility="{Binding HasAppUpdates, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>

                    <!-- Inline, non-modal completion state for the last finished batch - same
                         pattern as the Install tab's own completion surface, minus the expandable
                         per-failure detail list: each row already shows its own Failed state
                         directly in the grid above, so a second summary list would just repeat
                         that same information. -->
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                            Visibility="{Binding HasUpdateCompletionSummary, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateCompletionHasIssues}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UpdateCompletionHasIssues}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding UpdateCompletionSummaryText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <StackPanel Visibility="{Binding IsUpdatingApps, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgressPercent, Mode=OneWay}"
                                         Margin="0,0,0,6" Style="{StaticResource ThinProgressBarStyle}"/>
                            <TextBlock Text="{Binding UpdateProgressText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding IsUpdatingApps, Converter={StaticResource InvertedBoolToVisibility}}">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding UpdateAvailableCount, Mode=OneWay}"/>
                                <Run Text="update(s) available"/>
                            </TextBlock>
                            <Button Content="Update All"
                                    Command="{Binding UpdateAllCommand}"
                                    Style="{StaticResource UninstallButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER - install controls only ever appear once the catalog is genuinely ready AND
             the Install tab is the one selected (IsInstallFooterVisible) - no footer at all during
             WinGet preparation, catalog loading, a load failure, or while the Update tab is
             active. -->
        <Border Grid.Row="3" Style="{StaticResource FooterBarBorderStyle}"
                Visibility="{Binding IsInstallFooterVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>

                <!-- Inline, non-modal completion state for the last finished batch (replaces the
                     old "Install Complete" popup) - never shown while a new batch is running, and
                     always cleared/replaced the moment the next one starts
                     (InstallPageViewModel.ClearCompletionSummary). No raw WinGet output here -
                     Verbose.log remains authoritative for that. -->
                <!-- Visibility is driven ONLY by HasCompletionSummary - a locally-set Visibility
                     binding always wins over anything set via this same element's own Style
                     Setters/Triggers in WPF, so binding this to IsInstalling (as before) silently
                     defeated the Style's own "no summary yet" DataTrigger below, showing an empty
                     green bar with a lone checkmark right after page load. -->
                <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding HasCompletionSummary, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompletionHasIssues}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Data="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompletionHasIssues}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding CompletionSummaryText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Expander Header="Show details" Margin="24,6,0,0"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding CompletionFailureDetails}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>

                <Grid>
                    <!-- Real determinate progress - CompletedItems/TotalItems is an honest known
                         numerator/denominator (the selected count never changes mid-batch), not an
                         animated placeholder. -->
                    <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}"
                                VerticalAlignment="Center">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallProgressPercent, Mode=OneWay}"
                                     Margin="0,0,0,6" Style="{StaticResource ThinProgressBarStyle}"/>
                        <TextBlock Text="{Binding InstallProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                    </StackPanel>
                    <Grid Visibility="{Binding IsInstalling, Converter={StaticResource InvertedBoolToVisibility}}">
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                <Run Text="selected"/>
                            </TextBlock>
                            <Button Content="Install Selected"
                                    Command="{Binding InstallCommand}"
                                    Style="{StaticResource UninstallButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
