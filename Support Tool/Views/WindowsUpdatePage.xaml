<UserControl x:Class="Support_Tool.Views.WindowsUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WindowsUpdatePageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource PageBackgroundBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="UpdateRowTemplate" DataType="{x:Type vm:UpdateRowViewModel}">
            <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                Padding="24,14,20,14"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Windows Update" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding HeaderSubtitleText}"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">

            <!-- Idle: not started yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Check whether this computer is up to date, and install anything pending."
                           TextAlignment="Center" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,20"/>
                <Button Content="Check for updates" Command="{Binding StartCommand}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Checking connectivity / waiting for Ethernet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding IsWaitingForConnection, Converter={StaticResource BoolToVisibility}}">
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource IconPlaceholderBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Fill="{StaticResource WarningBorderBrush}" Stretch="Uniform"
                          Width="22" Height="22"
                          Data="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                </Border>
                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" FontSize="13"
                           TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,20,0,0"
                             Foreground="{StaticResource AccentGreenBrush}"
                             Background="{StaticResource SeparatorBrush}"/>
            </StackPanel>

            <!-- Running -->
            <Grid Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,20,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Prevent sleep while updating"
                                  IsChecked="{Binding PreventSleepEnabled}"
                                  Foreground="{StaticResource PrimaryTextBrush}" FontSize="12"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastCheckedText}" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                                 Foreground="{StaticResource AccentGreenBrush}"
                                 Background="{StaticResource SeparatorBrush}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="20,12,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column headers - same widths/alignment as UpdateRowTemplate's own Grid
                         (* | 80 | 100), inset by 10px to match that template's own Border
                         Padding="10,7" so header and row text line up exactly. Bold/PrimaryText
                         (not the dimmer SecondaryText used for the row values themselves) so the
                         headers read clearly, while staying visually subordinate to the page's
                         own 22px header above via the smaller 13px size. -->
                    <Grid Grid.Row="0" Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Update" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="Progress" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Grid.Column="2" Text="Status" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource UpdateRowTemplate}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Terminal states -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">

                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource IconPlaceholderBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Stretch="Uniform" Width="22" Height="22">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                <Setter Property="Data" Value="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm4.59 3.58L10 14.17l-2.59-2.58L6 13l4 4 8-8-1.41-1.42Z"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRebootRequired}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBorderBrush}"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStillPending}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBorderBrush}"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNoConnection}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBorderBrush}"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Fill" Value="#FF6B6B"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>

                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                <!-- Only shown while a deferred reboot is specifically waiting on another
                     in-progress toolkit operation (install/uninstall/debloat) - not shown for an
                     otherwise-deferred reboot with nothing else running. RebootNowCommand's own
                     CanExecute already disables the button below in this state; this just
                     explains why. -->
                <TextBlock Text="Waiting for the current operation to finish before this can restart."
                           Visibility="{Binding IsRebootWaitingForOtherOperation, Converter={StaticResource BoolToVisibility}}"
                           TextAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,12"/>

                <!-- Deferred reboot: the technician cancelled the countdown -
                     WindowsUpdateLifecycleCoordinator already persisted session state and
                     verified the resume task before the countdown ever showed, so this button
                     just routes back through the coordinator to re-verify and reboot - no new
                     Windows Update run, no session reset. "Check again" would be the wrong action
                     here (Windows Update itself is done for this pass; only the reboot remains),
                     so it's hidden in this sub-case. -->
                <Button Content="Reboot now" Command="{Binding RebootNowCommand}"
                        Visibility="{Binding IsRebootDeferred, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>

                <!-- Covers RebootRequired's own transient display (before/without deferral),
                     StillPending/NoConnection/Failed retry, and FullyUpToDate's own "check again"
                     affordance. -->
                <Button Content="Check again" Command="{Binding StartCommand}"
                        Visibility="{Binding IsRebootDeferred, Converter={StaticResource InvertedBoolToVisibility}}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
