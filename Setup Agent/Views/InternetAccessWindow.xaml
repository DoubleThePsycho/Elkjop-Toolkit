<Window x:Class="Setup_Agent.Views.InternetAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Elkjøp - Setup Agent"
        Icon="/Resources/favicon.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="{StaticResource PageBackgroundBrush}"
        Style="{StaticResource ChromelessWindowStyle}"
        Closing="Window_Closing"
        ContentRendered="Window_ContentRendered">
    <DockPanel LastChildFill="True">

        <!-- Custom titlebar (replaces the OS one - see ChromelessWindowStyle in ElkjopTheme.xaml) -->
        <Border DockPanel.Dock="Top" Height="{StaticResource TitleBarHeight}"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource PrimaryTextBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

    <Grid>
        <!-- Waiting state: no buttons at all, deliberately - skipping would defeat the point of
             blocking until the machine is actually online (Window_Closing cancels every close
             attempt, Alt+F4 included, while this panel is visible). -->
        <Grid x:Name="waitingPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="20,20,20,24">
                <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top"
                        Background="{StaticResource IconPlaceholderBrush}">
                    <Path Data="{StaticResource WarningGlyph}" Fill="{StaticResource WarningBorderBrush}"
                          Stretch="Uniform" Margin="8"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Top" MaxWidth="300">
                    <TextBlock Text="No internet connection detected" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="Please connect an Ethernet cable to continue setup."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                    Height="44"/>
        </Grid>

        <!-- Established state -->
        <Grid x:Name="establishedPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="20,20,20,24">
                <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top"
                        Background="{StaticResource IconPlaceholderBrush}">
                    <Path Data="{StaticResource InfoGlyph}" Fill="{StaticResource AccentGreenBrush}"
                          Stretch="Uniform" Margin="8"/>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Top" MaxWidth="300">
                    <TextBlock Text="Proceeding to update Windows" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="establishedBodyText" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Disabled until a cancellation path exists in the update loop - see
                         Setup Agent/TODO.md. Deliberately not IsCancel: Esc stays inert. -->
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False" MinWidth="90" Margin="0,0,10,0"/>
                    <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                            MinWidth="90" Click="OkButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
