<Application x:Class="Support_Tool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Support_Tool.Converters"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             xmlns:views="clr-namespace:Support_Tool.Views"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Application.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- Shared window-shell resources (TitleBarHeight, the non-resizable
                 ChromelessWindowStyle, WindowTitleBarBackgroundBrush/WindowBorderBrush/
                 WindowTitleBarSeparatorBrush) plus the full semantic vocabulary
                 (WindowBackgroundBrush/SurfaceRaisedBrush/TextPrimaryBrush/etc.) - see
                 ElkjopTheme.xaml's own remarks. Every consumer below this point that used to
                 reference a local legacy brush name has been migrated to reference one of these
                 semantic names directly; the legacy declarations that consequently had zero
                 remaining consumers were removed outright. What remains local below is either
                 genuinely Support-Tool-specific window-shell chrome (titlebar buttons, the
                 resizable window style) or a color with no matching staged semantic role
                 (IconPlaceholderBrush/Fg, ErrorIconBrush/Bg, ModalBodyBackgroundBrush) - see each
                 one's own remarks. -->
            <ResourceDictionary Source="pack://application:,,,/Themes/ElkjopTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- IconPlaceholderBrush: FIXED real bug (external review, real-hardware testing) - WPF's
             8-digit hex Color syntax is #AARRGGBB, not the CSS-style #RRGGBBAA every comment in
             this codebase (including this one's own prior revisions) mistakenly assumed. The old
             value "#FFFFFF15" was therefore never a subtle translucent white - it was FULLY
             OPAQUE (alpha=FF) bright yellow (R=FF,G=FF,B=15), silently rendering every icon
             "placeholder" circle across the whole app (Install/Apps/Programs icon slots, the WU
             footer icon, HomePage's quick-access cards, etc.) as a solid yellow badge instead of a
             subtle dark-theme circle - the actual source of the "muddy dark olive/yellow-green
             circular background" real-hardware finding, not the semantic brushes below. Correct
             order restores the intended ~8%-opacity translucent white. Same fix applied to the
             equivalent inline literals in HomePage.xaml/DebloaterPage.xaml/ProgramsPage.xaml. No
             equivalent semantic resource is staged for this "icon placeholder" role in
             ElkjopTheme.xaml, so this stays local. -->
        <SolidColorBrush x:Key="IconPlaceholderBrush"    Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="IconPlaceholderFgBrush"  Color="#4A5590"/>

        <!-- Semantic icon color pair for error glyph contexts - deliberately distinct from the
             shared ErrorBrush (#C42B1C, a thin accent/underline/hover color) rather than merged
             into it: ErrorIconBrush is a lighter, more legible red specifically for icon-glyph
             contexts (external review, real-hardware testing). SuccessIconBrush/SuccessIconBgBrush/
             WarningIconBgBrush used to live here too but had exact-value equivalents in
             ElkjopTheme.xaml's own semantic vocabulary (SuccessBrush/SuccessBackgroundBrush/
             WarningBackgroundBrush) once every consumer was migrated to reference those directly,
             so they were removed as redundant. -->
        <SolidColorBrush x:Key="ErrorIconBrush"          Color="#FF6B6B"/>
        <SolidColorBrush x:Key="ErrorIconBgBrush"        Color="#2E0F0F"/>

        <!-- Phase 5: a distinct, deliberately DARKER body palette for restart-critical modals
             (RebootCountdownWindow) - the point is visual separation from the main app surface,
             not a new brand color. ModalBodyBackgroundBrush is darker than the shared
             WindowBackgroundBrush; this stays a genuinely distinct visual role, not merged into
             it just to reduce resource count (see MainWindow/RebootCountdownWindow's own
             remarks), so it stays local and modal-specific. The titlebar background/outer
             border/separator this modal also uses are no longer modal-specific brushes - they
             are the canonical shared WindowTitleBarBackgroundBrush/WindowBorderBrush/
             WindowTitleBarSeparatorBrush from ElkjopTheme.xaml (merged above), which happen to
             carry over these exact values since this modal is where they originated. The former
             amber ModalWarningAccentBrush/warning strip is removed entirely, not replaced. -->
        <SolidColorBrush x:Key="ModalBodyBackgroundBrush"     Color="#0B0E1C"/>

        <!-- Custom titlebar chrome (System.Windows.Shell.WindowChrome - built into WPF, no NuGet
             package). This is Support Tool's own RESIZABLE variant, distinct from the shared,
             non-resizable "ChromelessWindowStyle" key that ElkjopTheme.xaml now provides (used by
             Account Setup's SetupWindow and, in this project, RebootCountdownWindow) - MainWindow
             needs a genuinely resizable, maximizable window, hence ResizeBorderThickness > 0 here
             and a titlebar with minimize/maximize-restore/close, not close-only. Reuses the
             shared TitleBarHeight token from the merged dictionary rather than redeclaring it. -->
        <Style x:Key="ResizableChromelessWindowStyle" TargetType="Window">
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="{StaticResource TitleBarHeight}"
                                         ResizeBorderThickness="5"
                                         GlassFrameThickness="0"
                                         CornerRadius="0"
                                         UseAeroCaptionButtons="False"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain titlebar buttons (minimize, maximize/restore) - IsHitTestVisibleInChrome is
             required or WindowChrome treats the whole CaptionHeight strip as drag-only and
             swallows the click. -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width"      Value="46"/>
            <Setter Property="Height"     Value="{StaticResource TitleBarHeight}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor"     Value="Arrow"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A274A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button - same shape as TitleBarButtonStyle but hovers a distinct red (#E81123)
             from Account Setup's own close-button convention in ElkjopTheme.xaml (ErrorBrush,
             #C42B1C) - kept deliberately separate under this same key name (direct declarations
             in this dictionary take precedence over the merged one) rather than unified, since
             this is Support Tool's own MainWindow-titlebar-button family (needs minimize/
             maximize siblings ElkjopTheme.xaml has no equivalent for) and unifying the hover
             color would be a visual change beyond this pass's titlebar/window-shell scope. Also
             used by RebootCountdownWindow's close button, unchanged from before this pass. -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InvertedBoolToVisibility" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <!-- ================================================================================
             PAGE CHROME - the header strip at the top of every page and the footer bar at the
             bottom of the pages that have one. The text inside each header (and any extra
             header controls, e.g. Apps/Programs' grid/list toggles) stays written out in each
             page's own XAML; only the repeated visual treatment lives here.
             ================================================================================ -->
        <Style x:Key="PageHeaderBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource SurfaceBackgroundBrush}"/>
            <Setter Property="Padding"         Value="24,14,20,14"/>
            <Setter Property="BorderBrush"     Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="PageHeadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
        </Style>

        <!-- Bottom bar: Install/Apps/Programs' own page footers, and MainWindow's persistent
             activity footers (which override Padding to their own slightly slimmer 20,10). -->
        <Style x:Key="FooterBarBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource SurfaceBackgroundBrush}"/>
            <Setter Property="Padding"         Value="20,12"/>
            <Setter Property="BorderBrush"     Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!-- The app's thin accent progress bar - every ProgressBar in Support Tool uses this
             look. Indeterminate/value/size-specific settings stay on each ProgressBar. -->
        <Style x:Key="ThinProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height"     Value="4"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
        </Style>

        <!-- Overall Windows Update progress - shared by the Windows Update page's own bar and
             MainWindow's persistent Windows Update footer (one calculation,
             WindowsUpdatePageViewModel.OverallWindowsUpdateProgressPercent, two bound displays).
             Indeterminate while there's no meaningful numeric total yet (connectivity check, the
             update search itself); determinate once real rows exist. -->
        <Style x:Key="WindowsUpdateProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource ThinProgressBarStyle}">
            <Setter Property="Minimum"         Value="0"/>
            <Setter Property="Maximum"         Value="100"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMeasurableProgress}" Value="True">
                    <Setter Property="IsIndeterminate" Value="False"/>
                    <Setter Property="Value" Value="{Binding OverallWindowsUpdateProgressPercent, Mode=OneWay}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================================================================================
             QUICK-ACCESS CARDS (HomePage, SetupHomePage) - a clickable card with an icon badge,
             a title and a one-line description. Each card's own icon/title/description text
             stays written out in its page.
             ================================================================================ -->
        <Style x:Key="QuickCardStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="24,20">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral (not accent-green) - these are plain navigation cards, not success/status
             indicators (see the semantic icon brush remarks above). Background is WPF's
             #AARRGGBB order - a translucent white, not the opaque yellow "#FFFFFF12" would be. -->
        <Style x:Key="QuickCardIconBadgeStyle" TargetType="Border">
            <Setter Property="Width"               Value="40"/>
            <Setter Property="Height"              Value="40"/>
            <Setter Property="CornerRadius"        Value="20"/>
            <Setter Property="Background"          Value="#12FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin"              Value="0,0,0,12"/>
        </Style>

        <Style x:Key="QuickCardIconStyle" TargetType="Path">
            <Setter Property="Fill"                Value="{StaticResource IconPlaceholderFgBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Width"               Value="20"/>
            <Setter Property="Height"              Value="20"/>
            <Setter Property="Stretch"             Value="Uniform"/>
        </Style>

        <Style x:Key="QuickCardTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="FontSize"      Value="14"/>
            <Setter Property="Foreground"    Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin"        Value="0,0,0,4"/>
        </Style>

        <Style x:Key="QuickCardDescriptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="Foreground"    Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>

        <!-- ================================================================================
             APPS / PROGRAMS TOOLBAR + ITEM LISTS (DebloaterPage, ProgramsPage; the card-grid
             container style is also used by InstallPage's per-category grids)
             ================================================================================ -->

        <!-- Grid/list view toggle. Bind Tag to the ViewState flag that means "this toggle is the
             active view" (e.g. Tag="{Binding ViewState.IsGridView}") - the active toggle gets the
             accent fill and a dark glyph. The glyph Path inside uses ViewToggleIconStyle, which
             follows this Button's Foreground. -->
        <Style x:Key="ViewToggleButtonStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Width"            Value="34"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18FFFFFF"/>
                </Trigger>
                <!-- Declared after IsMouseOver so the active fill wins while hovered. -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground"  Value="#1A1B28"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewToggleIconStyle" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width"   Value="14"/>
            <Setter Property="Height"  Value="14"/>
            <Setter Property="Fill"    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!-- Search box + its "Search ..." watermark, overlaid in the same Grid cell. The
             watermark's Text and its SearchText-empty Visibility binding stay on each page. -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>

        <Style x:Key="SearchWatermarkTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Margin"            Value="12,0,0,0"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
            <Setter Property="Foreground"        Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Item container for the card grids (ItemsControl + WrapPanel/UniformGrid) - just the
             3px horizontal gutter between cards. -->
        <Style x:Key="CardGridItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <!-- Item container for the list views - strips ListBoxItem's own selection/hover chrome
             entirely; each row's InstalledItemRowTemplate card draws its own. -->
        <Style x:Key="PlainListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared button styles -->

        <Style x:Key="UninstallButtonStyle" TargetType="Button">
            <Setter Property="Background"     Value="{StaticResource BrandPrimaryBrush}"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="20,8"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BrandPrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Support Tool scrollbar - one shared style applied globally (implicit, no
             x:Key, TargetType=ScrollBar) so every ScrollViewer in the app - Install catalog,
             Apps/Debloater, Programs, and anywhere else a ScrollViewer appears - gets the same
             narrow, dark-theme, arrow-free scrollbar automatically, with no per-page XAML needed.
             Reuses existing semantic brush tokens (DividerBrush/SurfaceHoverBrush/AccentBrush)
             rather than inventing new hardcoded colors. The two track RepeatButtons are given Opacity="0"
             (a standard WPF technique for this exact recipe) instead of a custom template, since
             their only job is to handle page-up/page-down clicks invisibly - PART_Track/PART_*
             naming follows ScrollBar's own template contract. -->
        <Style x:Key="SupportToolScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SupportToolScrollBarThumbStyle}" Margin="0,2"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SupportToolScrollBarThumbStyle}" Margin="2,0"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared Apps/Programs grid+list card template (external review: DebloaterPage.xaml and
             ProgramsPage.xaml carried byte-for-byte identical copies of this same DataTemplate,
             yet the Programs grid still looked visibly taller/clunkier than the Apps grid despite
             that - the real cause was UniformGrid sizing every cell to the tallest cell's own
             NATURAL measured height, and Programs rows more often populate all three text lines
             (Name+Version+Publisher) than Apps rows do, so the identical template still rendered
             differently per page. A single fixed Height (sized for the worst case: all three text
             lines populated) removes that possibility entirely - both pages' grids now size every
             cell identically regardless of which optional fields happen to be populated on a given
             row. One shared copy also means any future visual change only needs to happen once. -->
        <DataTemplate x:Key="InstalledItemRowTemplate" DataType="{x:Type vm:InstalledItemViewModel}">
            <Border Padding="12,8" CornerRadius="6" Margin="0,3" Height="76"
                    ToolTip="{Binding Tooltip}" ToolTipService.IsEnabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                        <Border Background="{StaticResource IconPlaceholderBrush}" CornerRadius="8"
                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}">
                            <Path Fill="{StaticResource IconPlaceholderFgBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-16v4h4V2h-4zm-6 4h4V2h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                        </Border>
                        <Image Source="{Binding Icon}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Version}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding Version, Converter={StaticResource NullToVisibility}}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Publisher}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding Publisher, Converter={StaticResource NullToVisibility}}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsHitTestVisible="False"/>
                </Grid>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- DataTemplates: maps each ViewModel type to its View -->
        <DataTemplate DataType="{x:Type vm:HomePageViewModel}">
            <views:HomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupHomePageViewModel}">
            <views:SetupHomePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicePageViewModel}">
            <views:ServicePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallPageViewModel}">
            <views:InstallPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DebloaterPageViewModel}">
            <views:DebloaterPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsPageViewModel}">
            <views:ProgramsPage/>
