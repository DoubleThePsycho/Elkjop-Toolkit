<Window x:Class="Setup_Agent.Views.SetupCompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Setup complete"
        Icon="/Resources/favicon.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Segoe UI"
        Background="{StaticResource PageBackgroundBrush}"
        Style="{StaticResource ChromelessWindowStyle}"
        ContentRendered="Window_ContentRendered">
    <DockPanel LastChildFill="True">

        <!-- Custom titlebar (replaces the OS one - see ChromelessWindowStyle in ElkjopTheme.xaml) -->
        <Border DockPanel.Dock="Top" Height="{StaticResource TitleBarHeight}"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource PrimaryTextBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Button Grid.Column="2" Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="20,20,20,24">
            <Border Width="40" Height="40" CornerRadius="8" VerticalAlignment="Top"
                    Background="{StaticResource IconPlaceholderBrush}">
                <Path Data="{StaticResource CheckCircleGlyph}" Fill="{StaticResource AccentGreenBrush}"
                      Stretch="Uniform" Margin="8"/>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Top" MaxWidth="300">
                <TextBlock Text="Windows is fully up to date" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock x:Name="messageText" Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
                    MinWidth="90" HorizontalAlignment="Right" Click="OkButton_Click"/>
        </Border>
    </Grid>
    </DockPanel>
</Window>
