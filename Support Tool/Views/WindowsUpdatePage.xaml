<UserControl x:Class="Support_Tool.Views.WindowsUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Support_Tool.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WindowsUpdatePageViewModel, IsDesignTimeCreatable=False}"
             Background="{StaticResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <DataTemplate x:Key="UpdateRowTemplate" DataType="{x:Type vm:UpdateRowViewModel}">
            <!-- Alternating background bound to the generated container's own AlternationIndex
                 (ItemsControl.AlternationCount="2" set on the ItemsControl below) - a subtle
                 brightness step using the same SurfaceRaisedBrush already used elsewhere for a
                 "slightly raised" surface, not a new/louder color invented for this. -->
            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Value="1">
                                <DataTrigger.Binding>
                                    <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}" Path="(ItemsControl.AlternationIndex)"/>
                                </DataTrigger.Binding>
                                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- Phase 5, external review: Update | Status | Progress (was Update |
                         Progress | Status) - the width swaps WITH the semantic column, not just
                         the label/binding, since Status carries the longer strings
                         ("Downloading...", "Pending restart") and Progress only ever shows "-"/
                         "N%"/"100%". -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <!-- Vertical divider lines between Update|Status and Status|Progress,
                         matched by identical dividers in the header row below so columns line up. -->
                    <Border Grid.Column="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                        <TextBlock Text="{Binding StateText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                        <TextBlock Text="{Binding PercentText}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBackgroundBrush}"
                Padding="24,14,20,14"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Windows Update" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding HeaderSubtitleText}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">

            <!-- Idle: not started yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Check whether this computer is up to date, and install anything pending."
                           TextAlignment="Center" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>
                <Button Content="Check for updates" Command="{Binding StartCommand}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Checking connectivity / waiting for Ethernet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding IsWaitingForConnection, Converter={StaticResource BoolToVisibility}}">
                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource IconPlaceholderBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Fill="{StaticResource WarningBrush}" Stretch="Uniform"
                          Width="22" Height="22"
                          Data="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                </Border>
                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" FontSize="13"
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,20,0,0"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource DividerBrush}"/>
            </StackPanel>

            <!-- Running -->
            <Grid Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,16,20,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Prevent sleep while updating"
                                  IsChecked="{Binding PreventSleepEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastActivityText}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- Indeterminate while there's no meaningful numeric total yet (connectivity
                         check, the update search itself); once real rows exist, switches to a
                         determinate bar driven by the one real aggregate percentage - the same
                         OverallWindowsUpdateProgressPercent the persistent footer also binds to. -->
                    <ProgressBar Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource DividerBrush}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="IsIndeterminate" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMeasurableProgress}" Value="True">
                                        <Setter Property="IsIndeterminate" Value="False"/>
                                        <Setter Property="Value" Value="{Binding OverallWindowsUpdateProgressPercent, Mode=OneWay}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <Grid Grid.Row="1" Margin="20,12,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column headers - same widths/alignment as UpdateRowTemplate's own Grid
                         (* | 100 | 80 - Phase 5, external review: Update | Status | Progress,
                         width swapped WITH the semantic column since Status carries the longer
                         strings), inset by 10px to match that template's own Border
                         Padding="10,7" so header and row text line up exactly. Bold/PrimaryText
                         (not the dimmer SecondaryText used for the row values themselves) so the
                         headers read clearly, while staying visually subordinate to the page's
                         own 22px header above via the smaller 13px size. -->
                    <Grid Grid.Row="0" Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Update" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <!-- Same dividers/padding as UpdateRowTemplate's own Status/Progress
                             Borders so the header lines up exactly with every row below it. -->
                        <Border Grid.Column="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                            <TextBlock Text="Status" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                            <TextBlock Text="Progress" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                        <!-- HorizontalScrollBarVisibility must be Disabled, not the default Hidden
                             - Hidden still permits scrolling, which makes WPF measure this
                             ScrollViewer's content with effectively infinite available width so it
                             can determine the content's "natural" scrollable size. That defeats the
                             *-sized Update-name column's shrinking (and its TextTrimming) below,
                             which is what let Progress/Status get pushed off past the visible
                             viewport when the window was narrowed - the star column never actually
                             got constrained. Every other page's own ScrollViewer already sets this
                             correctly; this was the one exception. -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource UpdateRowTemplate}"
                                          AlternationCount="2"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Terminal states -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                        Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}">

                <!-- Semantic background+foreground pair together per state (never mismatched
                     hues) - FullyUpToDate is the one genuine SUCCESS state here, using
                     SuccessBrush/SuccessBackgroundBrush (a true green, deliberately distinct from
                     the yellow-green brand accent - see App.xaml's own remarks), not
                     AccentBrush. -->
                <Border Width="48" Height="48" CornerRadius="24"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRebootRequired}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStillPending}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNoConnection}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrorIconBgBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Path Stretch="Uniform" Width="22" Height="22">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                <Setter Property="Data" Value="M12 2A10 10 0 1 0 22 12 10 10 0 0 0 12 2Zm0 2a8 8 0 1 1-8 8 8 8 0 0 1 8-8Zm4.59 3.58L10 14.17l-2.59-2.58L6 13l4 4 8-8-1.41-1.42Z"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRebootRequired}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStillPending}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNoConnection}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ErrorIconBrush}"/>
                                        <Setter Property="Data" Value="M12 2 1 21h22L12 2Zm0 3.99L19.53 19H4.47L12 5.99ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Border>

                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                <!-- Only shown while a deferred reboot is specifically waiting on another
                     in-progress toolkit operation (install/uninstall/debloat) - not shown for an
                     otherwise-deferred reboot with nothing else running. RebootNowCommand's own
                     CanExecute already disables the button below in this state; this just
                     explains why. -->
                <TextBlock Text="Waiting for the current operation to finish before this can restart."
                           Visibility="{Binding IsRebootWaitingForOtherOperation, Converter={StaticResource BoolToVisibility}}"
                           TextAlignment="Center" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                <!-- Deferred reboot: the technician cancelled the countdown -
                     WindowsUpdateLifecycleCoordinator already persisted session state and
                     verified the resume task before the countdown ever showed, so this button
                     just routes back through the coordinator to re-verify and reboot - no new
                     Windows Update run, no session reset. "Check again" would be the wrong action
                     here (Windows Update itself is done for this pass; only the reboot remains),
                     so it's hidden in this sub-case. -->
                <Button Content="Reboot now" Command="{Binding RebootNowCommand}"
                        Visibility="{Binding IsRebootDeferred, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>

                <!-- Covers RebootRequired's own transient display (before/without deferral),
                     StillPending/NoConnection/Failed retry, and FullyUpToDate's own "check again"
                     affordance. -->
                <Button Content="Check again" Command="{Binding StartCommand}"
                        Visibility="{Binding IsRebootDeferred, Converter={StaticResource InvertedBoolToVisibility}}"
                        Style="{StaticResource UninstallButtonStyle}" HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
